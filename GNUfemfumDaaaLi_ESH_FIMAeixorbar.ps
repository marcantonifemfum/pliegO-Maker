%%%% rutina de comprovacio de l'OS

mark  %% tanca de recollida d'escombraries

%% comprova si es Mac o Win

/MoW 0 def
%% comprova si trova fitxers o directoris amb l'identificador del Mac
(:*)
{
 MoW 1 add /MoW exch def
} 100 string filenameforall

%% EP! el PSNormalizer.framework va amb slash
%% treballant amb c:/GhostCall/GhostCall.exe el directori de treball es l'arrel d'aquest exe

MoW 0 eq
{
 /seP (./) def	%% utilitzat per fademo
 /bUsca (/) def  %% utilitzat a l'applet per extraure el nom del fitxer
 /liNka (/*.jp*) def  %% cadena per cercar tota mena d'extensions del JPEG (jpg, jpe, jpeg)
 /tEmp (tmp/) def  %% directori utilitzat a l'applet per desar tots els streams
 /aFeGeiX (tmp/afegeix) def  %% fitxer utilitzat per l'applet per afegir els Contents definits com una array en un sol fitxer
                             %% per tal d'evitar errors d'interpretacio per XERRA quan es trenquen continguts (p.e. [100 (aeiou)] en una array i TJ en la seguent)
 /macOS false def  %% pestell per saber si es Win
 /l'AseDelsCops (tmp/repica) def  %% fitxer on escriurem tots els PDF a tractar
%%UBESH eixorbar | necessitem el path absolut al fitxer JPEG decodificat xiuraw
 /nAdIu (C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/DaaaLi/tmp/xiuraw) def  %% fitxer on hi haura el raw de la imatge de base
}  %% Win/Unix
{  %% Mac (antics)
 /seP (:) def
 /bUsca (:) def	 %% utilitzat a l'applet per extraure el nom del fitxer
 /liNka (:*.jp*) def  %% solucio per cercar tota mena d'extensions del JPEG (jpg, jpe, jpeg)
 /tEmp (tmp:) def  %% utilitzat a l'applet per desar tots els streams
 /aFeGeiX (tmp:afegeix) def  %% utilitzat per l'applet per afegir els Contents definits com una array en un sol fitxer
                             %% per tal d'evitar errors d'interpretacio per XERRA quan es trenquen continguts (p.e. [100 (aeiou)] en una array i TJ en la seguent)
 /macOS true def  %% pestell per saber si es Mac
 /l'AseDelsCops (%ram%repica) def  %% fitxer on escriurem tots els PDF a tractar
 /nAdIu (tmp:xiuraw) def  %% fitxer on hi haura el raw de la imatge de base
}ifelse  %% sintaxi segons S.O.

cleartomark  %% recull les possibles escombraries (p.e. a Mac OS)

