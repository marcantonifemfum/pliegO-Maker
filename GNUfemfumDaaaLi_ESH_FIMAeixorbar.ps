ComElLincoln
dup
{
 %% macOS {(:)}{(/)}ifelse
 bUsca
 search
 {pop pop}{exit}ifelse
}loop dup
/TitolDocInfo exch def print flush  %% apuntem per pantalla l'arxiu d'imatge base del mural

%% creem el fitxer per decodificar a raw i filtrem la seva existència
{
 (r) file
} stopped
{
 BaBeL 3 get print flush quit
}if

%% aquí caldria un stopped ?
/cdn 65535 string def
nAdIu dup /elRAW exch def

{
 (w) file  %% aquí el fitxer de dades final al temp del GS/Distiller
} stopped
{
 BaBeL 25 get print flush stop
}if
/NaDiU exch def

{  %% stopped per detectar si el .JPEG base del mural és vàlid o defectuós

%!
%% DECODIFICADOR DE DADES AL SEU FORMAT ORIGINAL
 <<
   %/ColorTransform 1
 >> /DCTDecode filter         % aqui el filtre decodificador
 %/ASCIIHexDecode filter
 %/ASCII85Decode filter
 %/RunLengthDecode filter
 %/LZWDecode filter
 %<</K -1 /Columns 3432 /Rows 4850 /Blackls1 false>> /CCITTFaxDecode filter
 %/FlateDecode filter
 {  %% loop 1
  dup  %% dupliquen el fitxer de lectura
  cdn readstring  %% llegim el fitxer amb una cadena de capacitat màxima
  not
  {
   NaDiU exch writestring closefile exit
  } if  %% si hem arribat al final del fitxer (false) escrivim la cadena al fitxer final d'escriptura, tanquem el fitxer i sortim del loop
  NaDiU exch writestring  %% si no hem arribat al final sel fitxer (true) escrivim la cadena al fitxer final d'escriptura
 }loop  %% fi de loop 1
%%EOF

 %% test
 NaDiU dup flushfile closefile

} stopped
{  %% peta
 BaBeL 19 get print flush
 BaBeL 20 get print flush
 BaBeL 21 get print flush quit
}
{  %% no peta
 %%% AQUESTA UTILITAT IMPRIMEIX AUTOMATICAMENT UNA IMATGE .JPG
 %%% (c) marc&toni
 %%% 16.05.2001
 %%% Aquesta segona versio ho fa directament d'un fitxer .JPG sense haver de coneixer
 %%% previament l'espai de color ni les cols i fils

 ComElLincoln dup status
 {
  pop pop /FiFtxr exch def pop
 }  %% bytes totals del fitxer
 {  %% seria molt extrany que petés doncs aquest path ha estat trobat per filenameforall
  BaBeL 3 get print flush quit
 }ifelse

 (r) file /tesela exch def

 %% per trobar el segment d'inici que interessa: busquem els bytes 255 192 tants cops com
 %% el trobem dins el fitxer i ens quedem amb el darrer que és el bo
 %% utilitzem per primer cop l'estrategia del ReusableStream

 /laVeta 0 def  %% valor inicial per detectar si ho ha trobat

 {  %% loop per cercar la veta que dóna inici a la informació d'imatge JPEG
  tesela
  <<
    /Filter /SubFileDecode
    /DecodeParms <</EODCount 0 /EODString (\377\300)>>
    %/Intent 3
  >> /ReusableStreamDecode filter pop

  tesela fileposition dup FiFtxr eq
  {
   pop exit
  }  %% sortim tenint desada la darrera posició (que és la bona!) de (\377\300)
  {  %% desem la posició del doble byte clau on s'inicia la informació d'imatge que necessitem
   /laVeta exch def
  }ifelse
 }loop

 laVeta 0 ne  %% fitxer erroni (no te el doble byte clau)
 {  %% dades correctes
 
  %% missatge d'imatge correcte
  BaBeL 12 get print flush
 }
 {  %% dades incorrectes cal revisar l'estructura d'aquest JPEG
  BaBeL 19 get print flush
  BaBeL 20 get print flush
  BaBeL 21 get print flush quit
 }ifelse
}ifelse

%% lectura de les dades d'imatge gran del mural
%% captura del valor de files (y)
%% files (y)
tesela dup laVeta 3 add setfileposition read pop 256 mul
tesela dup laVeta 4 add setfileposition read pop add  %%(\n\n >>>> Files (Y) ... ) print flush ==
/_B exch def  %% (Y) FILES D'IMATGE

%% captura del valor de columnes (x)
%% columnes (x)
tesela dup laVeta 5 add setfileposition read pop 256 mul
tesela dup laVeta 6 add setfileposition read pop add  %%(\n\n >>>> Columnes (X) ... ) print flush ==
/_A exch def  %% (X) COLUMNES D'IMATGE

%% captura dels components de color (1, 3 o 4 canals)
%% components de color
tesela dup laVeta 7 add setfileposition read pop  %%(\n\n >>>> Components de Color ... ) print flush ==
/CNL exch def

%% bits per component de color (o per píxel)
tesela dup laVeta 2 add setfileposition read pop  %%(\n\n >>>> Bits x Comp ... ) print flush ==
/bXp exch def

%% test
tesela closefile

%%2001%%%%%%%%%%%%%%%%%%%%%%%%%%% CODI ESCRIBA
%% captura de funcions de menu ESCRIBA
elRAW /ElFitxer exch def  %% path
_B /piY exch def  %% files
_A /piX exch def  %% columnes
CNL /ECdex exch def  %% espai de color
%% fi de captura

%% detector no RGB
CNL 3 ne
{
 BaBeL 19 get print flush
 BaBeL 10 get print flush
 BaBeL 21 get print flush quit
} if

%% detector de consistencia dels bytes (en JPEG progressius que ara no detectem directament ho podem filtrar per aquí)
elRAW status pop pop pop exch pop  %% bytes totals del fitxer raw
piY piX mul CNL mul
eq
{  %% missatge d'imatge correcte
 BaBeL 8 get print flush
}
{
 BaBeL 19 get print flush
 BaBeL 20 get print flush
 BaBeL 21 get print flush quit
}ifelse

%% detector per informar del format final del mural i tallar el proces si excedeix les mides maximes compatibles per 1.2 o 1.3/1.4
%%UBESH eixorbar | com que aquesta crida és igualment vàlida pel GS, serà aquí hi haurem d'anar a buscar el gatell clau d'aplicació o no de les TransferFunctions!
currentdistillerparams /CompatibilityLevel get  % avaluem la versió de PDF
dup 1.2 gt
{
 /MinPag 3 def
 /MaxPag 14400 def
 /PDFver exch def
}
{
 /MinPag 72 def
 /MaxPag 3240 def
 /PDFver exch def
}ifelse

%% anàlisi de les mides del mural
BaBeL 14 get print flush
piX rd mul 32 string cvs print flush ( x ) print flush
piY rd mul 32 string cvs print flush 
BaBeL 15 get print flush

%% avaluem si entra dins els màxims
piX rd mul
piY rd mul 2 copy ge
{
 % MinPag lt {(Format massa petit) == stop}if
 pop MaxPag gt
 {
  BaBeL 5 get print flush PDFver 6 string cvs print flush
  BaBeL 7 get print flush MaxPag 32 string cvs print flush ( punts\n\n\n) print flush
  quit
 }if
}
{
 exch pop MaxPag gt
 {
  BaBeL 5 get print flush PDFver 6 string cvs print flush
  BaBeL 7 get print flush MaxPag 32 string cvs print flush ( punts\n\n\n) print flush
  quit
 }if
 % MinPag lt {(Format massa petit) == quit}if
} ifelse

%%%%% rodad'imatges.ps
%%%%% es una modificacio de fadct_4.ps
%%%%% emmagatzema al diccionari AlbUm les imatges JPEG en RGB valides ordenades
%%%%% en una array d'adreces on l'index de cada una correspon a un diccionari
%%%%% amb les dades d'imatge que necessitem per a cada una

%% missatge del garbellat d'imatges
BaBeL 2 get print flush

%% diccionari on desarem les dades necessaries per reproduir tota la col·lecció d'imatges
/AlbUm << >> def
mark  %% marca per recollir totes les adreces d'imatge vàlides

%% Aquest algorisme cerca per tot l'arbre de directoris i fitxers
%% a partir del punt on ens situem

%% a cercar
%(/*)  % tot l'arbre de directoris amb tots els fitxers
%()
%%% atencio: cal posar un detector de majuscules i minuscules
%macOS
%{(:*.jpg)}  % un determinat tipus de fitxer  % Mac
%{(/*.jpg)}  % un determinat tipus de fitxer  % Win+Unix
%ifelse

liNka /aCercar exch def

%% On ens situem ?
%% Hot Folder on començarem a pescar imatges (NO hi posem el darrer / !!!!)

PetaLenta

%% filtrem si duu el darrer / o : per moure 1 caracter la incrustació
%% del comodí de l'extensió del fitxer a cercar
dup dup length 1 sub get macOS {58 eq}{47 eq}ifelse
{
 /rEstem 1 def
}
{
 /rEstem 0 def
}ifelse  %% si porta / o : al final restem 1 caràcter al posicionat de la cua

%% incrusta aCercar a la cua de l'string de PetaLenta
dup length dup /deX exch def aCercar length add string dup 3 -1 roll
0 exch putinterval dup deX rEstem sub  %% restem 1 caràcter?
aCercar putinterval

/enTens -1 def  %% per saber si ha trobat res i quantes imatges en total (-1) ha trobat al dir

{  %% del filenameforall
 enTens 1 add /enTens exch def
 dup length string copy  %% fem un copy per que no es contaminin les strings i poder seguir treballant amb elles
 dup  %%==  % per que ens ho tregui per pantalleta
 dup
 {  %% loop
  %% macOS {(:)}{(/)}ifelse
  bUsca search
  {
   pop pop
  }
  {
   exit
  }ifelse
 }loop print flush  %% anotem per pantalla els arxius que formen el mural, a mida que son analitzats

 %%%%%%% FADCT

 /uau exch def

 uau dup status
 {
  pop pop /FiFtxr exch def pop
 }  %% bytes totals del fitxer
 {  %% seria molt extrany que petes doncs aquest path ha estat trobat per filenameforall
  BaBeL 3 get print flush quit
 }ifelse
 (r) file /tesela exch def

 %% per trobar el segment d'inici que interessa: busquem els bytes 255 192 tants cops com
 %% el trobem dins el fitxer i ens quedem amb el darrer que es el bo
 %% utilitzem per primer cop l'estrategia del ReusableStream

 /laVeta 0 def  % valor inicial per detectar si ho ha trobat

 {  % loop per cercar la veta que dona inici a la informacio d'imatge JPEG
  tesela
  <<
  /Filter /SubFileDecode
  /DecodeParms <</EODCount 0 /EODString (\377\300)>>
  %/Intent 3
  >> /ReusableStreamDecode filter pop

  tesela fileposition dup FiFtxr eq
  {pop exit}  % sortim tenint desada la darrera posicio (que es la bona!) de (\377\300)
  {/laVeta exch def}  % desem la posicio del doble byte clau on s'inicia la informacio d'imatge que necessitem
  ifelse
 }loop

 %% on comença la veta clau ?
 %laVeta (\n\n >>>> la Veta es a ... ) print flush ==
 %% que es el 'frame length' ?
 % inicialitzem el fitxer
 %tesela resetfile

 laVeta 0 ne  % fitxer erroni (no te el doble byte clau)

 {  % dades correctes

  %% captura del valor de files (y)
  %% files (y)
  tesela dup laVeta 3 add setfileposition read pop 256 mul
  tesela dup laVeta 4 add setfileposition read pop add  %(\n\n >>>> Files (Y) ... ) print flush ==
  /_B exch def  % (Y) FILES D'IMATGE

  %% captura del valor de columnes (x)
  %% columnes (x)
  tesela dup laVeta 5 add setfileposition read pop 256 mul
  tesela dup laVeta 6 add setfileposition read pop add  %(\n\n >>>> Columnes (X) ... ) print flush ==
  /_A exch def  % (X) COLUMNES D'IMATGE

  %% captura dels components de color (1, 3 o 4 canals)
  %% components de color
  tesela dup laVeta 7 add setfileposition read pop  %(\n\n >>>> Components de Color ... ) print flush ==
  /CNL exch def

  %% bits per component de color (o per pixel)
  tesela dup laVeta 2 add setfileposition read pop  %(\n\n >>>> Bits x Comp ... ) print flush ==
  /bXp exch def

  CNL 3 eq  % nomes deixem passar ara els RGB (que passara amb un CIE-Lab?)

  {  %% és RGB
   [
    0
    %% 1 canal (ploma, escala de grisos)
    << /DCD [0 1] /SCE {/DeviceGray setcolorspace} >>
    0
    %% 3 canals (RGB, L*a*b*)
    << /DCD [0 1 0 1 0 1] /SCE {/DeviceRGB setcolorspace} >>
    %% 4 canals (CMYK)
    << /DCD [0 1 0 1 0 1 0 1] /SCE {/DeviceCMYK setcolorspace} >>
   ] CNL get

   %% incrustem al dict de l'index els valors iCanals, iX, iY
   3 dict dup 3 -1 roll /iCanals exch put
   dup /iX _A put dup /iY _B put
   %% incrustem el dict de l'index al dict general AlbUm
   AlbUm exch enTens 5 string cvs cvn exch put

   %% detector de consistencia dels bytes (en JPEG progressius que ara no detectem directament ho podem filtrar per aqui)
   uau (r) file
   <<
     /Filter /DCTDecode
     /DecodeParms <</ColorTransform 1>>
     %/Intent 3
   >> /ReusableStreamDecode filter
   bytesavailable  %% bytes totals del fitxer raw
   _A _B mul CNL mul eq
   {  %% missatge d'imatge correcte
    BaBeL 12 get print flush
   }
   {  %% dades incorrectes, cal revisar l'estructura d'aquest JPEG
    BaBeL 19 get print flush
    BaBeL 20 get print flush
    pop
    enTens 1 sub /enTens exch def
   }ifelse
  }
  {  %% no es RGB
   BaBeL 19 get print flush
   BaBeL 10 get print flush
   pop
   enTens 1 sub /enTens exch def
  }ifelse
 }
 {  %% dades incorrectes, cal revisar l'estructura d'aquest JPEG
  BaBeL 19 get print flush
  BaBeL 20 get print flush
  pop
  enTens 1 sub /enTens exch def
 }ifelse

 %%%%%% fi de FADCT

} 256 string filenameforall

enTens 0 lt
{
 BaBeL 3 get print flush quit
}
{  %% missatge de fi de garbellat d'imatges i el total
 (\n . . . .  ) print flush enTens 1 add  %% el total real es enTens+1
 10 string cvs print flush BaBeL 11 get print flush
}ifelse

%% desem les adreces de les imatges valides a l'array iArray i aquest dins del dict AlbUm
counttomark array astore AlbUm exch /iArray exch put

% comprovem el dict
%AlbUm {== ==} forall quit
%AlbUm /0 get {== ==} forall quit

enTens /maxAlbum exch def  % per utilitzar-ho en el moment de muntar l'ICOgrama

%%%%%%%%%%%%% fi de rodad'imatges.ps

%%%%%%%%%%%%% aqui escriurem al dict RODAdic els procediments de cada imatge
%%%%%%%%%%%%% perque nomes s'hagin d'escriure una vegada

true
{  % no bloquem aixo per ara?
 /RODAi 0 def  % index per anomenar i cridar les imatges
 /RODAdic << >> def

 {  %% loop
  save  %% sobretot!
  RODAdic

  RODAi 5 string cvs cvn
  <<
    /ImageType 1

    AlbUm RODAi 5 string cvs get
    dup /iX get exch /iY get
    /Height exch
    3 -1 roll
    /Width exch

    AlbUm RODAi 5 string cvs get
    /iCanals get 
    /DCD get
    /Decode exch

    AlbUm /iArray get RODAi get
    /DataSource exch (r) file <</ColorTransform 1>> /DCTDecode filter
    /BitsPerComponent 8
    /ImageMatrix
    [
     AlbUm RODAi 5 string cvs get /iX get
     0 0
     AlbUm RODAi 5 string cvs get /iY get
     neg 0
     AlbUm RODAi 5 string cvs get /iY get
    ]
  >> put  % ho incrustem al diccionari RODAdic

  restore  %% sobretot!

  RODAi enTens eq {exit} if
  RODAi 1 add /RODAi exch def
 }loop
}if  %% no bloquem aixo per ara

pop  %% ens carreguem la mark

%% si el duu llavors farceix una cadena segons la sintaxi del Creation Date d'AcrobatPDF
(%Calendar%) /IODevice resourcestatus  % existeix el recurs del calendari+rellotge?
{  %% existeix! (probablement siguem dins GS)
 pop pop  % ens carreguem les altres dues respostes del query
 /QuinaHoraEs () def  % cadena d'inici per l'hora
 (%Calendar%) currentdevparams %{== ==}forall quit
 dup /Running get
 {  %% suposem q per refiar-nos del calendari aquesta entrada ha d'estar a true
  dup /Year get
  4 string cvs /aNY exch def
  dup /Month get
  2 string cvs /MeS exch def
  dup /Day get
  2 string cvs /Dia exch def
  dup /Hour get
  2 string cvs dup length dup 2 ne {1 add exch (00) dup 3 -1 roll 1 exch putinterval exch}if
  QuinaHoraEs length dup /afegit exch def add string dup 0 QuinaHoraEs putinterval
  dup afegit 4 -1 roll putinterval /QuinaHoraEs exch def

  QuinaHoraEs length dup /afegit exch def 1 add string dup 0 QuinaHoraEs putinterval
  dup afegit (:) putinterval /QuinaHoraEs exch def

  dup /Minute get dup 0 eq{3141618}{dup}ifelse/miNUT exch def  % x srand
  2 string cvs dup length dup 2 ne {1 add exch (00) dup 3 -1 roll 1 exch putinterval exch}if
  QuinaHoraEs length dup /afegit exch def add string dup 0 QuinaHoraEs putinterval
  dup afegit 4 -1 roll putinterval /QuinaHoraEs exch def
   
  QuinaHoraEs length dup /afegit exch def 1 add string dup 0 QuinaHoraEs putinterval
  dup afegit (:) putinterval /QuinaHoraEs exch def
   
  /Second get dup miNUT mul /llevor exch def  % x srand
  2 string cvs dup length dup 2 ne {1 add exch (00) dup 3 -1 roll 1 exch putinterval exch}if
  QuinaHoraEs length dup /afegit exch def add string dup 0 QuinaHoraEs putinterval
  dup afegit 4 -1 roll putinterval /QuinaHoraEs exch def
 }
 {  %% si Running es a false deixem un missatge d'avis, pero no fem res...
  pop
  (\n...>>> Hi ha %Calendar% pero Running es a false :-\( \n\n) print flush
  (00:00:00)/QuinaHoraEs exch def
  (1959)/aNY exch def
  (11)/MeS exch def
  (24)/Dia exch def
 }ifelse
}
{
 (\n...>>> NO hi ha %Calendar% pero no hi fa res... ;-\) \n\n) print flush
 (00:00:00)/QuinaHoraEs exch def
 (1959)/aNY exch def
 (11)/MeS exch def
 (24)/Dia exch def
}ifelse
%% si NO existeix... probablement siguem a Distiller

/RODAi 0 def  %% valor inicial del comptador d'imatges

%% desactivem l'aleatori si el nombre de fotos supera les 65535
ALEAi
{
 enTens 1 add 65535 gt
 {
  BaBeL 22 get print flush /ALEAi false def
 }if
} if

ALEAi  % fem l'aleatori ?
{  %% definim l'aleatori per primera vegada
   %% definicions aleatories

 %%usertime srand
 %% aixo ho necesita el GS xq realment sigui aleatori?
 llevor srand

 /number {rand exch mod} bind def
 %% nombre d'elements (fotos) a barallar
 enTens 1 add /AfotoS exch def
 AfotoS array /BoMBo exch def
 0  %% index comptador per l'array
 AfotoS 3 mul  %% tres cops el nombre d'elements
 {
  /HiEra false def
  %% sempre sortira un enter entre 0 i AfotoS-1
  AfotoS number /HiEs exch def
  BoMBo {HiEs eq {/HiEra true def exit}if} forall
  HiEra not {dup BoMBo exch HiEs put 1 add}if
 }repeat
 pop
 %% el treiem per ordre de l'aleatori actual i mirem si som al final per un null
 BoMBo RODAi get dup null eq {pop enTens dup /RODAi exch def} if
 /BOMBOi exch def
 %% fins aqui l'aleatori
}
{  %% NO
 RODAi /BOMBOi exch def
} ifelse

%%& fem el dict del fitxer d'imatge (aquest es raw i te les dades conegudes)

true
{
 /GoMeT  %% nom del diccionari form
 %<<
 %/FormType 1
 %/BBox [0 0 30 30]
 %/Matrix [1 0 0 1 0 0]
 %/PaintProc
 {
  save  %% sobretot!

  %/DeviceRGB setcolorspace
  %30 30 scale
  <<
    /ImageType 1
    %/Width 186
    %/Height 257
    AlbUm BOMBOi 5 string cvs get
    dup /iX get exch /iY get
    /Height exch
    3 -1 roll
    /Width exch
    /BitsPerComponent 8
    %/Decode [0 1 0 1 0 1]
    AlbUm BOMBOi 5 string cvs get
    /iCanals get 
    /DCD get
    /Decode exch
    %/ImageMatrix [186 0 0 -257 0 257]
    /ImageMatrix
    [
     AlbUm BOMBOi 5 string cvs get /iX get
     0 0
     AlbUm BOMBOi 5 string cvs get /iY get
     neg 0
     AlbUm BOMBOi 5 string cvs get /iY get
    ]
    %/DataSource (C:/MARCANTONI/FEMFUM/PROJECTES/IMGRAMA/ARRAYHOR/polmia2.jpg) (r) file <</ColorTransform 1>> /DCTDecode filter
    AlbUm /iArray get BOMBOi get
    /DataSource exch (r) file <</ColorTransform 1>> /DCTDecode filter
  >>
  dup dup /Width get exch /Height get
  2 copy lt  %% aqui avaluem si hem de primar les x o les y per que la imatge no deixi blancs
  {
   CoS mul exch div
   CoS exch
   dup /pelCap exch def  %% pesquem la Y de la imatge per corregir la posicio si la muntem pel cap
   scale
  }
  {
   exch CoS mul exch div
   CoS
   dup /pelCap exch def  %% pesquem la Y de la imatge per corregir la posicio si la muntem pel cap
   scale
  }ifelse
  image 
  restore  %% sobretot!
 }bind def
 %>> def
}
{
 /GoMeT  %% nom del diccionari de la imatge normal
 {
  RODAdic RODAi 5 string cvs cvn get %exec
  dup dup /Width get exch /Height get
  2 copy lt  %% aqui avaluem si hem de primar les x o les y per que la imatge no deixi blancs
  {
   CoS mul exch div
   CoS exch scale
  }
  {
   exch CoS mul exch div
   CoS scale 
  }ifelse
  image
 }bind def
}ifelse  %% test?

/iMides
{  %% algorisme que ens captura les mides x, y a escala de la imatge petita abans de executar image (GoMet)
 AlbUm BOMBOi 5 string cvs get
 dup /iX get exch /iY get
 2 copy lt  %% aqui avaluem si hem de primar les x o les y per que la imatge no deixi blancs per la composicio
 {
  CoS mul exch div
  CoS exch
  /pelCap exch def  %% pesquem la Y de la imatge per corregir la posicio si la muntem pel cap
  pop  %% ens carreguem la x
 }
 {
  exch CoS mul exch div
  CoS
  /pelCap exch def  %% pesquem la Y de la imatge per corregir la posicio si la muntem pel cap
  pop  %% ens carreguem la x
 }ifelse
}bind def


%%testVM per que no s'alenteixi quan genera daaaligrames molt grans
-1 vmreclaim  %% cal veure si realment incideix...

/salva'm save def

<</PageSize [ piX rd mul piY rd mul ]>> setpagedevice

%%2001%%%%%%%%%%%%%%%%%%%%%%%%%%% FI DE REDEFINICIO DE VARIABLES DEL MENU

%/iDX 0 def  %% valor inicial de l'index de la cadena de text

%!
%%%%% UTILITAT PER CONVERTIR PIXELS A UNA FORMA DE TEXT
%%%%% POT UTILITZAR-SE PER SIMULAR PROCESSOS DE TRAMAT
%% 11.04.2000 te un detector de nivell de gris minim que fa perfilar la lletra si es supera
%% (alenteix molt el treball!) + porta un pestell per si el volem activar
%% + utilitzem una nova variable anomenada /rmvt (espai proporcional) que fa la feina de rmvt
%% i avalua si em de llegir un altre pixel d'imatge per poder treballar amb composicio natural

%%%%%%%%%% noves definicions de color

%% pestell per l'espai de color de treball (0=grisos, 1=RGB, 2=CMYK)
%1
%/ECdex exch def

%% array de conversio de color
0 /icOl exch def  %% index del pixel que es llegeix per controlar la conversio
[
 0
 {255a1 mul /gRis exch def true}  %% escala de grisos
 0
 {
  [
   {255a1 mul /R exch def  icOl 1 add /icOl exch def}
   {255a1 mul /G exch def  icOl 1 add /icOl exch def}
   {255a1 mul /B exch def  0 /icOl exch def true}
  ] icOl get exec
 }  %% RGB
 {
  [
   {255a1 mul 1 exch sub dup /C exch def .3 mul /$C exch def icOl 1 add /icOl exch def}
   {255a1 mul 1 exch sub dup /M exch def .59 mul /$M exch def icOl 1 add /icOl exch def}
   {255a1 mul 1 exch sub dup /Y exch def .11 mul /$Y exch def icOl 1 add /icOl exch def}
   {255a1 mul 1 exch sub dup /K exch def /$K exch def 0 /icOl exch def true}
  ] icOl get exec
 }  %% CMYK
]
/piNta exch def

%% array de lectures de pixel
[
 0
 1
 0
 3
 4
]
/lleGeiX exch def

%% array d'activacio d'espai
[
 0
 {/DeviceGray setcolorspace gRis setcolor}
 0
 {
  %gsave  %/DeviceRGB setcolorspace
  %%%%% si es true dona invalidacces
  %false setpacking
  %{null mul}
  %%wcheck pstack quit
  % dup 0 R put 
  %{null mul}
  % dup 0 G put
  %{null mul}
  % dup 0 B put  
  %{0 mul}
  %setcolortransfer
  %true setpacking
 }
 {/DeviceCMYK setcolorspace C M Y K setcolor}
]
/eSpai exch def

/255a100 100 255 div def  %% conversor de valors 0-255 a 0-100
/255a1 1 255 div def  %% conversor de valors 0-255 a 0-1

/pntX piX def  %% meitat dels punts d'amplada de la imatge final
/pntY piY def  %% meitat dels punts de llargada "       "

rd
/rmvt exch def  %% ample del pixel (antic moviment relatiu entre caracters)

/255a100 100 255 div def  %% conversor de valors 0-255 a 0-100

/cX 0 def  %% posicions inicials dels caracters
/cY 0 def

/maXgraella 0 def  %% valor inicial de la variable de control per no excedir l'ample del pixel

ElFitxer
(r) file
/digitAl exch def

/estT true def  %% pestell per executar el calcul de temps 1 cop

/HvY
{
 0  %% comptador inicial
 {  %% inici del loop

  %% algorisme d'estimacio de temps segons la primera imatge pintada
  estT
  {
   usertime /UNAi exch def /estT false def /estTfi true def
  }if

  cX cY  %% posicio de l'inici de caracter

  %% estrategia per fer treballar el text amb composicio natural

  cX maXgraella ge
  {

%%%%%%%%%%%%%%  nous afegits de color

   lleGeiX ECdex get  %% repeticions de lectura de pixel

   {  %% repeat
    digitAl read  %% llegeix el pixel

    {

%dup ==

     piNta ECdex get cvx exec  %% conversio a de color que toca
    } 
    {
     false
    }ifelse  %% si arriba al final del fitxer deixa un false per sortir del loop
   }repeat


   eSpai ECdex get cvx exec  %% activacio de l'espai, la conversio i pintat

%%%%%%%%%%%%%%

   maXgraella rd add /maXgraella exch def  %% actualitzem
   /smp true def  %% sumem el pixel al compador de columnes ?
  }
  {

%%%%%%%%%%%%%%  nous afegits de color

   eSpai ECdex get cvx exec  %% activacio de l'espai, la conversio i pintat

%%%%%%%%%%%%%%

   true  %% torna a posar el valor del pixel anterior
   /smp false def  %% sumem el pixel al comptador de columnes
  }ifelse

  {
   2 -1 roll 2 -1 roll

   %false setpacking

   %currentpacking pstack quit

   %% desem les transfers en un fitxer
   true setglobal
   %macOS
   %{(:tmp:ctransfer)}
   %{(./tmp/ctransfer)}ifelse

   aFeGeiX (w) file /Ctransfer exch def

   false setglobal

%%%%%%%%%%%%%%%%%%% calibració de color idem paparazzialea

   %% filtrem el valor de RaNG perque estigui entre + gran de zero i 1
   RaNG 0 le
   {
    0.1 /RaNG exch def
   }if  %% si 0 o mes petit el deixem a .1
   
   RaNG 1 gt
   {
    1 /RaNG exch def
   }if  %% si es mes gran de 1 el deixem a 1

   %& escrivim els 3 array de transferencia

   %& Roig
   R RaNG sub 0 le
   {
    0 /MinR exch def
   }
   {
    R RaNG sub /MinR exch def
   }ifelse
   Ctransfer ( /TransferR [) writestring
   R 0 eq
   {
    256
    {
     Ctransfer 48 write Ctransfer 32 write
    }repeat
   }
   {
    R MinR sub 256 div MinR exch R
    {
     20 string cvs Ctransfer exch writestring Ctransfer 32 write
    }for
   }ifelse
   Ctransfer (] def ) writestring

   %&Verd
   G RaNG sub 0 le
   {
    0 /MinG exch def
   }
   {
    G RaNG sub /MinG exch def
   }ifelse
   Ctransfer ( /TransferG [) writestring
   G 0 eq
   {
    256
    {
     Ctransfer 48 write Ctransfer 32 write
    }repeat
   }
   {
    G MinG sub 256 div MinG exch G
    {
     20 string cvs Ctransfer exch writestring Ctransfer 32 write
    }for
   }ifelse
   Ctransfer (] def ) writestring

   %&Blau
   B RaNG sub 0 le
   {
    0 /MinB exch def
   }
   {
    B RaNG sub /MinB exch def
   }ifelse
   Ctransfer ( /TransferB [) writestring
   B 0 eq
   {
    256
    {
     Ctransfer 48 write Ctransfer 32 write
    }repeat
   }
   {
    B MinB sub 256 div MinB exch B
    {
     20 string cvs Ctransfer exch writestring Ctransfer 32 write
    }for
   }ifelse
   Ctransfer (] def ) writestring

   %% escrivim la crida de la transfer
   Ctransfer ( {255 mul cvi TransferR exch get}{255 mul cvi TransferG exch get}{255 mul cvi TransferB exch get}{0 mul} setcolortransfer ) writestring

%%%%%%%%%%%%%%%%%%% fins aqui lo del paparazzialea

   Ctransfer closefile

   %% executem l'espai de color particular de cada imatge
   AlbUm BOMBOi 5 string cvs get
   /iCanals get 
   /SCE get exec

   %macOS
   %{(:tmp:ctransfer)}
   %{(./tmp/ctransfer)} ifelse

   aFeGeiX (r) file cvx exec

   %true setpacking

   /alCel save def

   iMides  %% captura les x,y escalades de la imatge abans d'executar image
(QUESHIVEU?)pstack quit
   capOpeus
   {
    pelCap sub
   }if  %% arrenglerem pel cap de la imatge ?

   translate GoMeT  %image

   %RODAdic RODAi 10 string cvs cvn get image

   alCel restore

   % dup type /dicttype eq {pop}if
   %grestore

   ALEAi  %% fem l'aleatori ?
   {
    %% comptador de l'aleatori
    RODAi enTens eq
    {
     /RODAi -1 def
     %% definicions aleatories
     usertime srand
     %% aixo ho necesita el GS xq realment sigui aleatori?
     llevor srand

     /number
     {
      rand exch mod
     }bind def
     %% nombre d'elements (fotos) a barallar
     enTens 1 add /AfotoS exch def
     AfotoS array /BoMBo exch def
     0  %% index comptador per l'array
     AfotoS 3 mul  %% tres cops el nombre d'elements
     {
      /HiEra false def
      %% sempre sortira un enter entre 0 i AfotoS-1
      AfotoS number /HiEs exch def
      BoMBo
      {
       HiEs eq
       {
        /HiEra true def exit
       }if
      }forall
      HiEra not
      {
       dup BoMBo exch HiEs put 1 add
      }if
     }repeat
     pop
     %% fins aqui l'aleatori
    }if
    RODAi 1 add /RODAi exch def
    %% el treiem per ordre de l'aleatori actual i mirem si som al final per un null
    BoMBo RODAi get dup null eq
    {
     pop enTens dup /RODAi exch def
    }if
    /BOMBOi exch def
   }
   {  %% NO
    RODAi enTens eq
    {
     /RODAi -1 def RODAi /BOMBOi exch def
    }if
    RODAi 1 add /RODAi exch def
    RODAi /BOMBOi exch def
   }ifelse

   cX CoS add
   /cX exch def  %% actualitzem el valor de X per composicio natural
   smp
   {
    1 add
   }if  %% si hem repetit el pixel no el sumem
   dup  %% sumador del comptador
   piX eq
   {
    pop exit
   }if  %% has fet totes les columnes ?
  }if  %% s'executa mentre no arriba al final del fitxer
 }loop
}bind def


/HvX
{
 0
 {  %% loop
  dup rmvt mul  %% multiplicant per l'index tenim la posicio d'inici de fila
  neg /cY exch def /cX 0 def  %% actualitzem els valors del centre per l'inici de cada fila
  /maXgraella 0 def
  HvY  %% fa totes les columnes de la fila corresponent

  %% algorisme d'estimacio de temps segons la primera imatge pintada
  estTfi
  {
   /estTfi false def BaBeL 23 get print flush
   usertime UNAi sub 1000 div piY mul 60 div truncate cvi 5 string cvs print flush
   BaBeL 24 get print flush
  }if

  1 add dup  %% sumador del comptador

  %% comptador del % de la imatge construida
  dup piX mul 100 mul piX piY mul div round cvi 20 string cvs print flush (%\n . . . .  ) print flush

  piY eq
  {
   pop BaBeL 17 get print flush exit
  }if  %% has fet totes les files ?
 }loop
}bind def

%& posicio d'inici de la primera imatge de construccio del mural
0 piY rd mul rd sub
capOpeus {rd add}if  % corregim la y cap amunt si arrenglerem pel cap de la imatge
translate  % xamfra superior esquerra de la imatge final

%% missatge de generacio del mural
BaBeL 6 get print flush

HvX

%% incrustacio d'un diccionari privat per recollir i salvar dades del programari generador
%% (Daaali.ps) i de la clau LicenseID del Distiller utilitzat

%% diccionari privat com a objecte indirecte
mark /_objdef {DicPriv} /type /dict /OBJ pdfmark

%% contingut del diccionari privat
mark
{DicPriv}
%	<<
%	  /MRCT_FemFumID FemFumID  % la clau LicenseID en hexa la posem quan interroguem el Distiller
true setglobal
FemFumPriv dup /MRCT_GNU_Daaali_v (1.0) put  %% versio de l'Applet
false setglobal
%	>>
/PUT pdfmark

%% incrustem al Catalog
mark
{Catalog}
<<
  /MRCT_Daaali {DicPriv}
>> /PUT pdfmark
%% fins aqui la incrustacio del diccionari privat

