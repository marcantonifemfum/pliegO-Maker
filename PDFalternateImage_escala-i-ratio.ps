   %% NO ES POT imprimint OFUSCAT.pdf via Desa com a PDF, doncs envia a imprimir la captura de pantalla i no les dades (llavors no desofusca!)
   %% NO ES POT imprimint OFUSCAT.pdf via AdobePDF, doncs envia a imprimir la captura de pantalla i no les dades (llavors no desofusca!)
%% per desofuscar amb Firefox:
   %% NO ES POT imprimint OFUSCAT.pdf via Desa com a PDF, doncs envia a imprimir la captura de pantalla i no les dades (llavors no desofusca!)
   %% NO ES POT imprimint OFUSCAT.pdf via AdobePDF, doncs envia a imprimir la captura de pantalla i no les dades (llavors no desofusca!)
%% per desofuscar amb Brave:
   %% NO ES POT imprimint OFUSCAT.pdf via Desa com a PDF, doncs envia a imprimir la captura de pantalla i no les dades (llavors no desofusca!)
   %% NO ES POT imprimint OFUSCAT.pdf via AdobePDF, doncs envia a imprimir la captura de pantalla i no les dades (llavors no desofusca!)
%% per desofuscar amb Ghostscript:
   %% FUNCIONA gswin64c -q -dNOSAFER -o desOFUSCAT.pdf -sDEVICE=pdfwrite -dBATCH OFUSCAT.pdf

%% entorn Linux
%% per desofuscar amb CUPS:
   %% lp -d Hewlett-Packard_HP_Color_LaserJet_M553 OFUSCAT.pdf

%%AndroginAlterego etiquetem les entrades crítiques a editar per generar manualment les ofuscacions per aquesta tècnica
%% a partir d'ara formarà part de la bateria de proves d'ofuscació de PDF de la investigació "Common Margins" de l'IP Enric Senabre Hidalgo

<</PageSize
[  %%androginAlterego: cal quadrar el format de pàgina amb la proporció de la imatge tant per pantalla com per impressora (han de ser idèntiques?)
 595 842
]>> setpagedevice

%%AlterEgo = 123
%%AlterEgoStream = 456
%%LaMascaraXdemo = 789

%% anomenem la imatge x pantalla
[/_objdef {AlterEgo_123pg1} /NI pdfmark

%%AndroginAlterego punt d'origen de la imatge LL (pantalla i impressora?)
0 0  %% xamfrà LL
translate

%% plumeru
%gsave 1 0 0 setrgbcolor 0 0 596 843 rectfill grestore

%%AndroginAlterego escala de la imatge (pantalla i impressora?)
595 595  %% adaptem la ràtio que sabem que té la imatge de pantalla (quadrada!) a la mida tot d'ample
scale

gsave

%%AndroginAlterego espai de color de la imatge (pantalla i impressora?)
/DeviceRGB setcolorspace

%% executem la imatge x pantalla
<<
%%AndroginAlterego: quadra l'escala de la imatge de pantalla amb la proporció del format de pàgina?
  /Width 100  %% píxels d'ample de la imatge de pantalla

%%AndroginAlterego: quadra l'escala de la imatge de pantalla amb la proporció del format de pàgina?
  /Height 100  %% píxels d'alt de la imatge de pantalla

%%AndroginAlterego matriu amb els valors d'ample i alt en píxels del fitxer d'imatge que només es veurà per pantalla
  /ImageMatrix
  [
   100 0 0 -100 0 100
  ]
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /BitsPerComponent 8
  /DataSource
%%AndroginAlterego path del fitxer d'imatge que només es veurà per pantalla
  %(C:/Users/Marc Antoni/UB/FIMA/eixorbar/pix-001NOMESpantalla.jpg)
  %(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/androginAlterego/PANTALLA_853x1280.jpg)
  %(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/androginAlterego/presentacio20demaig/PANTALLAv2-001_2479x3542.jpg)  %% CommonMargins
  (C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/pasapasTerminal/imatge100x100_Pantalla.jpg)  %% imatge quadrada
  (r) file
%%AndroginAlterego decodificador d'imatge si s'escau
  /DCTDecode filter 0 () /SubFileDecode filter
>> image

grestore



%% creem l'stream de dades per la imatge alternativa
[/_objdef {AlterEgoStream_456pg1} /type /stream /OBJ pdfmark

%%AndroginAlterego path al fitxer d'imatge que només es veurà quan l'imprimim
% llegim el fitxer a incrustar a AlterEgo
% les dades d'imatge han de ser binaries (cal provar amb hexa) doncs ell sempre
% les acaba comprimint amb Flate o LZW. En el cas que llegim dades DCT (jpg) cal decodificar-les
% abans d'entar-les a l'stream de dades
%(C:/windows/escritorio/forum/applets/alterego/80jo101.raw) (r) file
%<ffffffffffffffff>
%(C:/Users/Marc Antoni/UB/FIMA/eixorbar/pix-002NOMESimpresa.jpg)
%(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/androginAlterego/IMPRESA_853x1280.jpg)
%(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/androginAlterego/presentacio20demaig/IMPRESSORAv2-001_2479x3508.jpg)  %% Common Margins
%(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/pasapasTerminal/imatge100x100_Impressora.jpg)  %% imatge amb ídem resolució i ràtio que la de pantalla
%(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/pasapasTerminal/imatge50x100_Impressora.jpg)  %% imatge (doble d'alta que ample) ràtio diferent a la de pantalla
%(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/pasapasTerminal/imatge25x25_Impressora.jpg)  %% imatge amb menys resolució que la de pantalla (ídem ràtio)
(C:/Users/Marc\ Antoni/UB/FIMA/eixorbar/pasapasTerminal/imatge200x200_Impressora.jpg)  %% imatge amb ídem ràtio però amb més resolució que la de pantalla
(r) file
%%AndroginAlterego decodificador d'imatge si s'escau
/DCTDecode filter 0 () /SubFileDecode filter

%% incrustem el fitxer de lectura dins l'stream
[{AlterEgoStream_456pg1} 2 index /PUT pdfmark

closefile  % tanquem el fitxer que queda a la pila


%%ESF no ens cal la màscara ara?
false{
%%%%%% creacio de l'objecte de la imatge de mascara per demo
% creem l'stream de dades per l'objecte d'imatge de mascara per Demo (logo FemFum)
[/_objdef {LaMascaraXdemo_789} /type /stream /OBJ pdfmark
% entrem les dades del dict d'imatge de mascara
[{LaMascaraXdemo_789}
<<
   /Type /XObject /Subtype /Image
   /Width 8 /Height 8
   /BitsPerComponent 1
   /ImageMask true
>> /PUT pdfmark
% incrustem el fitxer de dades .RAW a 1 bitXpixel dins l'stream
[{LaMascaraXdemo_789}
%(C:/windows/escritorio/forum/applets/alterego/rauxa_bn.RAW) (r) file
<ffffffffffffffff> 0 () /SubFileDecode filter
/PUT pdfmark
% tanquem l'stream
[{LaMascaraXdemo_789} /CLOSE pdfmark
%%%%%%% fi de dades de mascara
}if


%% entrem les dades d'imatge a l'stream alternatiu
[{AlterEgoStream_456pg1}
<<
  /Type /XObject
  /Subtype /Image

%%AndroginAlterego ample en píxels del fitxer d'imatge que només es veurà quan l'imprimim
  /Width 200

%%AndroginAlterego alt en píxels del fitxer d'imatge que només es veurà quan l'imprimim
  /Height 200

%%AndroginAlterego espai de color de la imatge (pantalla i impressora?)
  /ColorSpace /DeviceRGB
  /BitsPerComponent 8
  %/ImageMatrix
%%EPS! no hi fa res això perquè és codi PDF! matriu amb els valors d'ample i alt en píxels del fitxer d'imatge que només es veurà per pantalla
  %[
  % 100 0 0 -100 0 100
  %]
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /Name /FemFum_AlterEgo

  %% entrem la clau per emascarar les impressions per Demo amb el logo de FemFum a 1 bitXpixel
  % /Mask {LaMascaraXdemo_789}  %%ESH no ens cal ara
  
>> /PUT pdfmark

%% tanquem l'stream alternatiu
[{AlterEgoStream_456pg1} /CLOSE pdfmark


% creem les entrades de la imatge alternativa dins el diccionari de la imatge per pantalla
[{AlterEgo_123pg1} << /Alternates [ <</Image {AlterEgoStream_456pg1}
/DefaultForPrinting true >> ] >> /PUT pdfmark

%% CATALOG INFO
[
%%AndroginAlterego personalitzem el DOCinfo?
 /Title
 %(AlterEgo & Androgin PDF)
 (EiXORBaR PDF obfuscator)
 /Subject (estratègia androginAlterego)
 /Author (Common Margins pliegO'makers Team)
