%!
%% derivada de... NouLectorDeJPEGs10.ps ...aquesta versió es limita a validar el JPEGs que llegeix i desar els píxels d'ample/alt i els canals

%%PROMPT de capçalera (per saber on som en cas d'error i evolucions)
(\n\n----- CONTEXT ESH_NouLectorDeJPEGs11.ps -----\n\n) print flush

mark  %% sembla que genera brossa?

%%UBESH l'adreça del JPEG ve de l'stack
%(C:/Users/Marc\ Antoni/CelObert/8mes1/A3mes1_EpitifiMalesHerbes_AcelObertDret.jpg)
exch  %% fem saltar la mark darrera el path
dup /araJPEG exch def

{  %d'stopped

 %% captura de dades del JPEG i comprovacio de si existeix...
 dup status
 {
  pop pop
  % el fitxer fa...
  /FiFtxr exch def pop
  dup /elD'ara exch def  % path+Nom del fitxer que processem
  (r) file /tesela exch def  % fitxer de lectura
 }
 {
  (...NO TROBO EL JPEG!) == tesela closefile stop
 }ifelse

	
 %% mirem el cap i els peus (marcadors d'inici i final) del fitxer aviam si son normatius...
 tesela FiFtxr 2 sub setfileposition
 tesela 2 string readstring pop <FFD9> eq
 {
  %% matem els missatges
  %(PEUS OK) ==

  tesela dup 0 setfileposition
  2 string readstring pop <FFD8> eq
  {
   %% matem els missatges
   %(CAP OK) ==
   /SoRTiM false def  % pestell de sortida
%% explorem el fitxer per localitzar els marcadors significatius que duen les dades d'imatge (qualsevol d'ells es valid)

   {  %% loop
    tesela 2 string readstring  %% llegim el segment
    {
     /SeGMeNT exch def
     0 1 6
     {  %% for
      [<FFC0> <FFC1> <FFC2> <FFC3> <FFC5> <FFC6> <FFC7>]  %% marcadors significatius
      exch get SeGMeNT eq
      {
       %% matem els missatges
       % (JA EL TINC !!!) ==
       tesela 10 string readstring pop

       %% captura del valor de files (y)
       dup dup 3 get 256 mul exch 4 get add

       %% matem els missatges
       % (\n >>>> Files (Y) ... ) print flush dup ==
       /_B exch def  % (Y) FILES D'IMATGE

       %% captura del valor de columnes (x)
       dup dup 5 get 256 mul exch 6 get add

       %% matem els missatges
       % (\n >>>> Columnes (X) ... ) print flush dup ==

       /_A exch def  % (X) COLUMNES D'IMATGE

       %% captura dels components de color (1, 3 o 4 canals)
       dup dup 7 get

       %% matem els missatges
       % (\n >>>> Components de Color ... ) print flush dup ==

       /CNL exch def

       %% bits per component de color (o per pixel)
       dup dup 2 get

       %% matem els missatges
       % (\n >>>> Bits x Comp ... ) print flush dup == (\n\n) print flush

       /bXp exch def

       /SoRTiM true def
      }if
     }for

     SoRTiM not
     {
      tesela 2 string readstring
      {  %% llegim la llargada del segment per saltar al seguent...
       dup 0 get 256 mul exch 1 get add
       2 sub string tesela exch readstring
       {
        pop
       }
       {
        pop tesela closefile exit
       }ifelse														                                        }
      {
       pop tesela closefile exit
      }ifelse
     }if
    }
    {
     pop tesela closefile exit
    }ifelse

    SoRTiM
    {
     tesela closefile exit
    }if
   }loop

   SoRTiM not
   {
    (\n\n <<<< NO podem llegir correctament les dades d'aquest JPEG\n\n) print flush
   }if

   {  %% stopped
    [
     {PETA!}

     %% 1 canal (ploma, escala de grisos)
     {
      /DCD [0 1] def
      /SCE {/DeviceGray setcolorspace} def
     }

     {PETA!}

     %% 3 canals (RGB, L*a*b*)
     {
      /DCD [0 1 0 1 0 1] def
      /SCE {/DeviceRGB setcolorspace} def
     }

     %% 4 canals (CMYK)
     {
      /DCD [1 0 1 0 1 0 1 0] def
      /SCE {/DeviceCMYK setcolorspace} def
     }
    ]
    CNL get exec
   }stopped
   {  %% canals incorrectes
    (\n\n <<<< Canals Incorrectes...\n\n) print flush stop
   }if
  }
  {
   (CAP KAPPUT)== stop
  }ifelse
 }
 {
  (PEUS KAPPUT)== stop
 }ifelse

 [ _A _B CNL DCD ]  %% deixem a l'stack l'array de valors per ser desada
 counttomark 1 add 1 roll
 cleartomark  %% sembla que genera brossa?
}stopped
{
 (\n)print flush araJPEG print flush( ...alguna cosa no va a l'hora en aquest JPEG!\n\n) print flush
 /almenys1error true def
 cleartomark  %% sembla que genera brossa?
}if

%%TEST
%_A _B CNL DCD SCE currentcolorspace pstack

