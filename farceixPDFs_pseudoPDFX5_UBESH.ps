%%REpublica cal retornar el nom del PDF repicat per CaLi2CoPi
%%URLUBESH
%% com ho fem perquè els noms dels PDFs 1 o + arribin dins una array?
bateiG
   /pedeefa exch def

%%UBESH
%% Ara treballem amb 1 sol PDF d'entrada que generarà 1 sol PDF de sortida (cada 2 planes del PDF resultant, anvers/revers, serà 1 pliegOS)
%%+1 cal saber quantes pàgines té el PDF d'entrada a imposar
aPmaker  %% aquest paquet desat per CaLi2CoPi duu tantes arrays com pàgines amb els valors del CropBox, en cas d'existir, i si no del MediaBox
length /poPDF exch def  %% és el nombre total de pàgines originals del PDF d'entrada i sempre serà així

%%+2 cal saber quin nUp hem triat
M2 dup 0 eq
{
 pop 8
}if
/Nup exch def

%%+3 cal saber quin enquadernat hem triat
M9     %% null = fem 1 sol llibret de pàgines seguides fins a esgotar l'nUp (si falten pàgines s'omplen amb buides a la cua i si en sobren es talla)
       %% true = encartem amb tants llibrets com pàgines tingui el PDF i l'nUp triat (si falten pàgines s'omplen amb buides a la cua)
       %% false = apilem amb tants llibrets com pàgines tingui el PDF i l'nUp triat (si falten pàgines s'omplen amb buides a la cua)
/nqdrnt exch def

%%UBESH
%% filtrem que el primer paràmetre sigui igual o més petit que el segon
M12 aload pop 2 copy gt 1 index 0 ne and  %% tret que el segon valor sigui zero que equival a la darrera pàgina!
{  %% com que la primera pàgina no pots ser més gran que la segona
 exch 2 array astore /M12 exch def  %% capgirem els valors
 (\n\n >>>> capgirem els valors de la pagina d'inici i final de l'assaig\n\n)print flush
}
{
 pop pop
}ifelse

%%UBESH
%%M10 ASSAGEM EL MAPA D'IMPOSICIÓ?

%% true = si assagem el mapa d'imposició no crearem el PDF amb el pliegOS i només donarem com a resultat una matriu per a M8
%% i l'anàlisi que mostrarem estarà basat en el resultat d'aquesta matriu

%% false = aplicarem el mapa d'imposició definit a M8 i generarem el PDF amb el pliegOS
%% el mapa d'imposició podrà ser l'usuari de pliegOS qui l'ajusti manualment i l'anàlisi que mostrarem estarà basat en aquesta matriu

M10
{  %% assaig i NO fem el llançat i només generem el mapa d'imposició en base al nombre de pàgines del PDF i l'enquadernat triat

%%UBESH sedassem | garbellem | destriem
%(\n\n | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |\n)print flush
(\n\n - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n)print flush
%(\n\n + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +\n)print flush
%(\n\n ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~\n)print flush
%(\n\n / / / / / / / / / / / / / / / / / / / / / / / / / / / / / /\n)print flush
%( \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \n\n)print flush
%(\n : : : : : : : : : : : : : : : : : : : : : : : : : : : : : :\n)print flush
%%(\n                s   e   d   a   s   s   e   m\n\n)print flush
(\n                  assagem el mapa d'imposicio\n\n)print flush
%( : : : : : : : : : : : : : : : : : : : : : : : : : : : : : :\n\n)print flush
%(\n \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \n)print flush
%( / / / / / / / / / / / / / / / / / / / / / / / / / / / / / /\n)print flush
%( ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~\n\n)print flush
%( + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +\n\n)print flush
( - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n\n)print flush
%( | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |\n\n)print flush

 %% tant si fem totes les pàgines del PDF d'entrada (poPDF) com si hem acotat un determinat rang de pàgines (M12), mirem si és un múltiple exacte de l'Nup triat
 %% si no fos així, farciríem amb pàgines en blanc la cua del llançat fins a quadrar-lo (ja ho fem en determinats casos)
 M12 0 get 0 eq
 {  %% si el primer valor és zero és que comencem per la pàgina 1
  /iLlançat 1 def
 }
 {  %% si és un altra xifra mirem que no estigui fora de rang
  M12 0 get /iLlançat exch def
  iLlançat 0 lt
  {  %% no fos que hi hagi un nombre negatiu!
   (\n\n >>>> rectifiquem el valor negatiu d'inici de la primera pagina\n\n)print flush
   /iLlançat 1 def
  }
  {
   iLlançat poPDF gt
   {  %% no fos que hi hagi un nombre més gran que el de pàgines del PDF d'entrada!
    (\n\n >>>> rectifiquem el valor d'inici de pagina per superar el maxim permes\n\n)print flush
    /iLlançat poPDF def  %% qui sap si més endavant tindrà sentit gestionar enquadernats que capgirin l'ordre de les pàgines?
   }if
  }ifelse
 }ifelse

 M12 1 get 0 eq
 {  %% si el segon valor és zero és que acabarem per la pàgina final del PDF d'entrada
  /fLlançat poPDF def
 }
 {  %% si és un altra xifra mirem que no estigui fora de rang
  M12 1 get /fLlançat exch def
  fLlançat 0 lt
  {  %% no fos que hi hagi un nombre negatiu!
   (\n\n >>>> rectifiquem el valor negatiu de final de la darrera pagina\n\n)print flush
   /fLlançat poPDF def
  }
  {
   fLlançat poPDF gt
   {  %% no fos que hi hagi un nombre més gran que el de pàgines del PDF d'entrada!
    (\n\n >>>> rectifiquem el valor de final de pagina per superar el maxim permes\n\n)print flush
    /fLlançat poPDF def  %% qui sap si més endavant tindrà sentit gestionar enquadernats que capgirin l'ordre de les pàgines?
   }if
  }ifelse
 }ifelse

 %% tornem a avaluar el nombre de pàgines del PDF d'entrada que imposarem
 %% pPDF és el nombre de pàgines del PDF d'entrada que imposarem i poPDF és el nombre total de pàgines originals del PDF d'entrada
 fLlançat iLlançat sub 1 add /pPDF exch def  %% com que beu de M12 sempre seran pàgines seguides doncs no hi ha risc que hi hagi ni pagines repetides ni null

 %% aquesta rutina genera mapes d'imposició en els 3 tipus d'enquadernat:
 nqdrnt null eq
 {  %% 1 sol llibret de pàgines seguides (apilat) fins que s'esgoti l'nUp (si falten pàgines s'omplen amb buides a la cua i si en sobren es talla)
  [
   iLlançat 1  %% comencem per iLlançat sumant 1 fins a fLlançat
   Nup 2 mul pPDF sub
   dup 0 eq
   {  %% les pàgines escollides del PDF d'entrada quadren exactament amb el nombre de pàgines de l'nUp triat
    pop fLlançat
    /enBlanc 0 def
   }
   {
    dup 0 gt
    {  %% les pàgines escollides del PDF d'entrada són MENYS que l'nUp triat
     /enBlanc exch def  %% llavors en farcirem en blanc
     fLlançat
    }
    {  %% les pàgines escollides del PDF d'entrada són MÉS que l'nUp triat
     pop /enBlanc 0 def
     iLlançat Nup 2 mul add 1 sub  %% llavors tallarem fins a omplir nUp
    }ifelse
   }ifelse

   {
   }for

   enBlanc
   {
    null
   }repeat
  ]
  /mapaDimposicio exch def
 }
 {  %% tants llibrets com faci falta fins a esgotar les pàgines del PDF d'entrada per l'nUp triat
  nqdrnt  %% true = encartat | false = apilat
  {  %% encartem els pliegOS
   [  %% inici de l'array d'imposició

M13 0 ne
{  %% tret que M13 sigui zero?

    %% com que mana M13 per sobre el rang definit via M12, sempre que ens demani un nombre de llibrets inferior:
    M13 Nup 2 mul mul dup pPDF lt  %% el nombre de pàgines a fer que M13 ens marca a través del nombre de llibrets és més petita?
    {
     dup /pPDF exch def  %% actualitzem el valor de pPDF
     iLlançat add 1 sub /fLlançat exch def  %% i actualitzem la pàgina on acaba el llançat
    }
    {
     pop
    }ifelse

}if

   %% com que no és més petita el valor actual de pPDF (nombre de pàgines del PDF a imposar) ja ens val
   pPDF Nup 2 mul sub  %% nombre de pàgines a part el llibret central
   dup 0 eq
   {  %% no hi haurà encartat perquè només dóna per 1 llibret exacte
    pop
%    1 1 pPDF
    iLlançat 1 fLlançat
    {
    }for
    ]  %% fi de l'array d'imposició
    /enBlanc 0 def
    /Nllibrets 0 def  %% és el nombre de llibrets (arrays) que envolten al llibret central
   }
   {
    dup 0 lt
    {  %% hi haurà 1 sol llibret amb pàgines en blanc (null) que inicialment situarem a la cua
     abs /dNULLS exch def
%     1 1 pPDF
     iLlançat 1 fLlançat
     {
     }for
     dNULLS
     {
      null
     }repeat
     ]  %% fi de l'array d'imposició
     /enBlanc dNULLS def
     /Nllibrets 0 def  %% és el nombre de llibrets (arrays) que envolten al llibret central
    }
    {  %% hi hauran 2 o més llibrets encartats

     %% deduïm quants llibrets sortiran a part del llibret central
     dup Nup 2 mul div ceiling cvi dup

     M13 0 ne  %% tret que M13 sigui zero!
     {  %% avaluem aquí com limitem els llibrets segons M13 > 0
      1 add M13 sub 0 le
%      (aVEUREsiVAS 3)pstack quit
      {  %% com que el nombre de llibrets que demana M13 és igual o més gran els totals reals
       dup  %% deixem igual Nllibrets
      }
      {  %% com que el nombre de llibrets que demana M13 és més petit que els totals reals
       pop M13 1 sub dup  %% mana M13 i li restem el llibret central
      }ifelse
     }if

     /Nllibrets exch def  %% és el nombre de llibrets (arrays) que envolten al llibret central
     div Nup 2 mul exch sub dup 0 ne  %% hi hauran pàgines en blanc?
%(aVEUREsiVAS 2)pstack quit
     {  %% SÍ, hi haurà pàgines en blanc
      Nllibrets mul round cvi
      /enBlanc exch def  %% nombre de pàgines en blanc
     }
     {  %% NO hi haurà pàgines en blanc
      pop
      /enBlanc 0 def
     }ifelse

%     1 /PgEncartada exch def
     iLlançat /PgEncartada exch def

     Nllibrets
     {  %% meitat dels llibrets encartats a l'esquerra
      1 1 Nup
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      [
     }repeat
     enBlanc 0 ne  %% hi ha pàgines en blanc?
     {  %% sí
      Nup enBlanc sub dup 0 lt
      {  %% si és més petit de zero és que també hi haurà pàgines en blanc al llibret central o a la penúltima array
       abs cvi /dNULLSc exch def  %% nombre de null que indiquen pàgines en blanc al llibret central o a la penúltima array
       /dNULLS Nup def  %% nombre de null que indiquen pàgines en blanc al llibret més extern
       %% ara aquí cal esbrinar si /dNULLSc va al llibret central o a la penúltima array
       Nllibrets 1 eq     %% només si és 1 durà null al llibret central
       {
        /blanquesALmig true def
        /blanquesALpenultim false def
       }
       {
        /blanquesALpenultim true def
        /blanquesALmig false def
       }ifelse
      }
      {
       pop enBlanc cvi /dNULLS exch def  %% nombre de null que indiquen pàgines en blanc al llibret més extern
       /blanquesALmig false def
       /blanquesALpenultim false def
      }ifelse
      /blanquesAcua true def
     }
     {  %% no
      /blanquesALmig false def
      /blanquesAcua false def
      /blanquesALpenultim false def
     }ifelse

     %% llibret central
     blanquesALmig  %% n'hi ha?
     {  %% fins on arriben les pàgines del PDF?
      1 1 Nup 2 mul dNULLSc sub
     }
     {  %% comportament normal
      1 1 Nup 2 mul
     }ifelse
     {
      pop PgEncartada dup 1 add /PgEncartada exch def
     }for
     blanquesALmig  %% n'hi ha?
     {
      dNULLSc
      {  %% acabem de farcir amb null el llibret central on no arriben les pàgines del PDF
       null
      }repeat
     }if
     ]

     %% meitat dels llibrets encartats a la dreta
     enBlanc 0 ne
     {  %% hi ha pàgines blanques
      blanquesALpenultim blanquesAcua and
      {  %% a la cua i al penúltim array
       Nllibrets 2 sub  %% fem tots els llibrets menys els 2 darrers
      }
      {  %% només a la cua
       Nllibrets 1 sub  %% fem tots els llibrets menys el darrer
      }ifelse
     }
     {  %% comportament normal
      Nllibrets
     }ifelse
     {  %% repeat
      1 1 Nup
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      ]
     }repeat

     %% aquí el penúltim llibret/array per ficar null com a pàgines en blanc en cas que n'hi hagi
     blanquesALpenultim  %% hi ha pàgines en blanc a la penúltima array?
     {
      1 1 Nup dNULLSc sub  %% escrivim la cua de pàgines finals del PDF
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      %% la cua de pàgines en blac
      dNULLSc
      {
       null
      }repeat
      ]
     }if

     %% aquí el darrer llibret/array per ficar null com a pàgines en blanc en cas que n'hi hagi
     blanquesAcua  %% hi ha pàgines en blanc?
     {
      1 1 Nup dNULLS sub  %% escrivim la cua de pàgines finals del PDF
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      %% la cua de pàgines en blac
      dNULLS
      {
       null
      }repeat
      ]
     }if
     %% la fi de l'array d'imposició ja va implícita
    }ifelse
   }ifelse

%dup == (matrius aniuades) ==  %pstack quit

   /mapaDimposicio exch def
  }
  {  %% apilem els pliegOS
   %% fem tants llibrets (nUps) de pàgines seguides fins que s'esgoti el rang de pàgines de PDF a imposar (si falten pàgines s'omplen amb buides)
   %% calculem quants pliegOS ens surten i si hi ha pàgines en blanc (que ara deixarem a la cua)
   pPDF Nup 2 mul mod 0 eq
   {  %% si la divisió és exacte voldrà dir que NO hi ha pàgines en blanc
    pPDF Nup 2 mul div cvi /nPliegOS exch def  %% nombre de pliegOS (llibrets)
    /enBlanc 0 def
   }
   {  %% hi haurà pàgines en blanc
    pPDF Nup 2 mul div ceiling cvi /nPliegOS exch def  %% nombre de pliegOS que generem
    %% pels pliegOS que generem comptem quantes pàgines en blanc necessitarem fins a completar el darrer nUp
    Nup 2 mul nPliegOS mul pPDF sub  %% restem les pàgines del PDF del nombre total de pàgines de l'nUp triat
    cvi /enBlanc exch def
   }ifelse

   [  %% com que els pliegOS van seguits ara posem totes les pàgines en 1 sol array
    iLlançat 1 fLlançat  %% de pàgina d'origen a pàgina de final
    {
    }for

    enBlanc  %% si n'hi han, farcim la cua de pàgines en blanc per quadrar l'nUp
    {
     null
    }repeat
   ]
   M13 0 ne
   {  %% aquí un nombre que potser inferior, igual o superior al nombre de pliegos per fer totes les pàgines
    M13 nPliegOS ge
    {  %% si és igual o superior, només avisem que es faran el mateixos llibrets dins el rang de pàgines del PDF d'entrada que s'hagin triat
     (\n\n >>>> mantenim el nombre de llibrets dins el rang de pagines que hagueu escollit\n\n)print flush
%(RESnoCANVIA)pstack quit
    }
    {  %% es demanen menys llibrets dels totals que enquadernarien totes les pàgines
     %% com que el rang de pàgines M12 ja s'ha aplicat
     0 Nup 2 mul M13 mul getinterval  %% extraiem el rang de llibrets des del principi
%%CAL redefinir /nPliegOS?
     /nPliegOS M13 def
%%CAL redefinir /enBlanc si el nombre de llibrets obliga a afegir-ne?
     /enBlanc 0 def
     dup
     {
      null eq
      {
       enBlanc 1 add /enBlanc exch def
      }if
     }forall
%%CAL redefinir /fLlançat i /pPDF
     /pPDF 0 def
     dup
     {
      dup null eq
      {
       pop
      }
      {
       pPDF 1 add /pPDF exch def
       /fLlançat exch def
      }ifelse
     }forall

%     (MENYSllibrets)pstack quit
%%CAL veure si la rutina de Pignorades treballarà bé
    }ifelse
   }if
   /mapaDimposicio exch def
   %(APILEM)pstack quit
  }ifelse
 }ifelse

 %% excepcions segons el tipus de llançat 
 M2 0 eq
 {  %% excepció pel Handbook
  [
   mapaDimposicio
   {
   }forall
   pop pop pop pop pop pop pop
   null null null null null null null
  ]
  /mapaDimposicio exch def
  %% ajustem, si cal, el valor de fLlançat
  fLlançat 9 gt
  {
   /fLlançat 9 def
  }if
  %% ajustem, si cal, el valor de pPDF
  pPDF 9 gt
  {
   /pPDF 9 def
  }if
  9 /ppLl exch def  %% pàgines per llibret
 }
 {
  Nup 2 mul /ppLl exch def  %% pàgines per llibret
 }ifelse

 /rEpEtIcIons 0 def  %% en un assaig de nou en nou no es produiran mai repeticions de pàgines
}
{  %% FEM el llançat servint-nos del mapa d'imposició del menú M8
 (\n\n - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n)print flush
 (\n                     f e m   p l i e g O S\n\n)print flush
 ( - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n\n)print flush

 %% l'excepció de quan M8 és una array buida ens obliga a fer totes les pàgines en base a l'enquadernat triat: 1 (null), encartat (true), apilat (false)
 %% i a tornar-lo a desar com a M8
 M8 length 0 eq
 {  %% hem de generar l'array M8
  %% pàgina d'inici, oàgina de final i el nombre de pàgines del PDF d'entrada que imposarem
  /fLlançat poPDF def
  /iLlançat 1 def
  %% pPDF és el nombre de pàgines del PDF d'entrada que imposarem i poPDF és el nombre total de pàgines originals del PDF d'entrada
  fLlançat iLlançat sub 1 add /pPDF exch def  %% com que beu de M12 sempre seran pàgines seguides doncs no hi ha risc que hi hagi ni pagines repetides ni null

  %% excepcions segons el tipus de llançat 
  M2 0 eq
  {  %% excepció pel Handbook
 % [
 %  mapaDimposicio
 %  {
 %  }forall
 %  pop pop pop pop pop pop pop
 %  null null null null null null null
 % ]
 % /mapaDimposicio exch def
   %% ajustem, si cal, el valor de fLlançat
   fLlançat 9 gt
   {
    /fLlançat 9 def
   }if
   %% ajustem, si cal, el valor de pPDF
   pPDF 9 gt
   {
    /pPDF 9 def
   }if
   /ppLl 9 def  %% pàgines per llibret
  }
  {
   Nup 2 mul /ppLl exch def  %% pàgines per llibret
  }ifelse

  %% aquesta rutina genera mapes d'imposició en els 3 tipus d'enquadernat:
  nqdrnt null eq
  {  %% 1 sol llibret de pàgines seguides (apilat) fins que s'esgoti l'nUp (si falten pàgines s'omplen amb buides a la cua i si en sobren es talla)
   [
    iLlançat 1  %% comencem per iLlançat sumant 1 fins a fLlançat
    Nup 2 mul pPDF sub
    dup 0 eq
    {  %% les pàgines escollides del PDF d'entrada quadren exactament amb el nombre de pàgines de l'nUp triat
     pop fLlançat
     /enBlanc 0 def
    }
    {
     dup 0 gt
     {  %% les pàgines escollides del PDF d'entrada són MENYS que l'nUp triat
      /enBlanc exch def  %% llavors en farcirem en blanc
      fLlançat
     }
     {  %% les pàgines escollides del PDF d'entrada són MÉS que l'nUp triat
      pop /enBlanc 0 def
      iLlançat Nup 2 mul add 1 sub  %% llavors tallarem fins a omplir nUp
     }ifelse
    }ifelse

    {
    }for

    enBlanc
    {
     null
    }repeat
   ]
   /mapaDimposicio exch def
  }
  {  %% tants llibrets com faci falta fins a esgotar les pàgines del PDF d'entrada per l'nUp triat
   nqdrnt  %% true = encartat | false = apilat
   {  %% encartem els pliegOS
    [  %% inici de l'array d'imposició

%M13 0 ne
%{  %% tret que M13 sigui zero?

    %% com que mana M13 per sobre el rang definit via M12, sempre que ens demani un nombre de llibrets inferior:
%    M13 Nup 2 mul mul dup pPDF lt  %% el nombre de pàgines a fer que M13 ens marca a través del nombre de llibrets és més petita?
%    {
%     dup /pPDF exch def  %% actualitzem el valor de pPDF
%     iLlançat add 1 sub /fLlançat exch def  %% i actualitzem la pàgina on acaba el llançat
%    }
%    {
%     pop
%    }ifelse

%}if

    %% com que no és més petita el valor actual de pPDF (nombre de pàgines del PDF a imposar) ja ens val
    pPDF Nup 2 mul sub  %% nombre de pàgines a part el llibret central
    dup 0 eq
    {  %% no hi haurà encartat perquè només dóna per 1 llibret exacte
     pop
%    1 1 pPDF
     iLlançat 1 fLlançat
     {
     }for
     ]  %% fi de l'array d'imposició
     /enBlanc 0 def
     /Nllibrets 0 def  %% és el nombre de llibrets (arrays) que envolten al llibret central
    }
    {
     dup 0 lt
     {  %% hi haurà 1 sol llibret amb pàgines en blanc (null) que inicialment situarem a la cua
      abs /dNULLS exch def
%     1 1 pPDF
      iLlançat 1 fLlançat
      {
      }for
      dNULLS
      {
       null
      }repeat
      ]  %% fi de l'array d'imposició
      /enBlanc dNULLS def
      /Nllibrets 0 def  %% és el nombre de llibrets (arrays) que envolten al llibret central
     }
     {  %% hi hauran 2 o més llibrets encartats

      %% deduïm quants llibrets sortiran a part del llibret central
      dup Nup 2 mul div ceiling cvi dup

%      M13 0 ne  %% tret que M13 sigui zero!
%      {  %% avaluem aquí com limitem els llibrets segons M13 > 0
%       1 add M13 sub 0 le
%      (aVEUREsiVAS 3)pstack quit
%       {  %% com que el nombre de llibrets que demana M13 és igual o més gran els totals reals
%        dup  %% deixem igual Nllibrets
%       }
%       {  %% com que el nombre de llibrets que demana M13 és més petit que els totals reals
%        pop M13 1 sub dup  %% mana M13 i li restem el llibret central
%       }ifelse
%      }if

      /Nllibrets exch def  %% és el nombre de llibrets (arrays) que envolten al llibret central
      div Nup 2 mul exch sub dup 0 ne  %% hi hauran pàgines en blanc?
%(aVEUREsiVAS 2)pstack quit
      {  %% SÍ, hi haurà pàgines en blanc
       Nllibrets mul round cvi
       /enBlanc exch def  %% nombre de pàgines en blanc
      }
      {  %% NO hi haurà pàgines en blanc
       pop
       /enBlanc 0 def
      }ifelse

%     1 /PgEncartada exch def
      iLlançat /PgEncartada exch def

      Nllibrets
      {  %% meitat dels llibrets encartats a l'esquerra
       1 1 Nup
       {
        pop PgEncartada dup 1 add /PgEncartada exch def
       }for
       [
      }repeat
      enBlanc 0 ne  %% hi ha pàgines en blanc?
      {  %% sí
       Nup enBlanc sub dup 0 lt
       {  %% si és més petit de zero és que també hi haurà pàgines en blanc al llibret central o a la penúltima array
        abs cvi /dNULLSc exch def  %% nombre de null que indiquen pàgines en blanc al llibret central o a la penúltima array
        /dNULLS Nup def  %% nombre de null que indiquen pàgines en blanc al llibret més extern
        %% ara aquí cal esbrinar si /dNULLSc va al llibret central o a la penúltima array
        Nllibrets 1 eq     %% només si és 1 durà null al llibret central
        {
         /blanquesALmig true def
         /blanquesALpenultim false def
        }
        {
         /blanquesALpenultim true def
         /blanquesALmig false def
        }ifelse
       }
       {
        pop enBlanc cvi /dNULLS exch def  %% nombre de null que indiquen pàgines en blanc al llibret més extern
        /blanquesALmig false def
        /blanquesALpenultim false def
       }ifelse
       /blanquesAcua true def
      }
      {  %% no
       /blanquesALmig false def
       /blanquesAcua false def
       /blanquesALpenultim false def
      }ifelse

      %% llibret central
      blanquesALmig  %% n'hi ha?
      {  %% fins on arriben les pàgines del PDF?
       1 1 Nup 2 mul dNULLSc sub
      }
      {  %% comportament normal
       1 1 Nup 2 mul
      }ifelse
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      blanquesALmig  %% n'hi ha?
      {
       dNULLSc
       {  %% acabem de farcir amb null el llibret central on no arriben les pàgines del PDF
        null
       }repeat
      }if
      ]

      %% meitat dels llibrets encartats a la dreta
      enBlanc 0 ne
      {  %% hi ha pàgines blanques
       blanquesALpenultim blanquesAcua and
       {  %% a la cua i al penúltim array
        Nllibrets 2 sub  %% fem tots els llibrets menys els 2 darrers
       }
       {  %% només a la cua
        Nllibrets 1 sub  %% fem tots els llibrets menys el darrer
       }ifelse
      }
      {  %% comportament normal
       Nllibrets
      }ifelse
      {  %% repeat
       1 1 Nup
       {
        pop PgEncartada dup 1 add /PgEncartada exch def
       }for
       ]
      }repeat

      %% aquí el penúltim llibret/array per ficar null com a pàgines en blanc en cas que n'hi hagi
      blanquesALpenultim  %% hi ha pàgines en blanc a la penúltima array?
      {
       1 1 Nup dNULLSc sub  %% escrivim la cua de pàgines finals del PDF
       {
        pop PgEncartada dup 1 add /PgEncartada exch def
       }for
       %% la cua de pàgines en blac
       dNULLSc
       {
        null
       }repeat
       ]
      }if

      %% aquí el darrer llibret/array per ficar null com a pàgines en blanc en cas que n'hi hagi
      blanquesAcua  %% hi ha pàgines en blanc?
      {
       1 1 Nup dNULLS sub  %% escrivim la cua de pàgines finals del PDF
       {
        pop PgEncartada dup 1 add /PgEncartada exch def
       }for
       %% la cua de pàgines en blac
       dNULLS
       {
        null
       }repeat
       ]
      }if
      %% la fi de l'array d'imposició ja va implícita
     }ifelse
    }ifelse

%dup == (matrius aniuades) ==  %pstack quit

    /mapaDimposicio exch def
   }
   {  %% apilem els pliegOS
    %% fem tants llibrets (nUps) de pàgines seguides fins que s'esgoti el rang de pàgines de PDF a imposar (si falten pàgines s'omplen amb buides)
    %% calculem quants pliegOS ens surten i si hi ha pàgines en blanc (que ara deixarem a la cua)
    pPDF Nup 2 mul mod 0 eq
    {  %% si la divisió és exacte voldrà dir que NO hi ha pàgines en blanc
     pPDF Nup 2 mul div cvi /nPliegOS exch def  %% nombre de pliegOS (llibrets)
     /enBlanc 0 def
    }
    {  %% hi haurà pàgines en blanc
     pPDF Nup 2 mul div ceiling cvi /nPliegOS exch def  %% nombre de pliegOS que generem
     %% pels pliegOS que generem comptem quantes pàgines en blanc necessitarem fins a completar el darrer nUp
     Nup 2 mul nPliegOS mul pPDF sub  %% restem les pàgines del PDF del nombre total de pàgines de l'nUp triat
     cvi /enBlanc exch def
    }ifelse

    [  %% com que els pliegOS van seguits ara posem totes les pàgines en 1 sol array
     iLlançat 1 fLlançat  %% de pàgina d'origen a pàgina de final
     {
     }for

     enBlanc  %% si n'hi han, farcim la cua de pàgines en blanc per quadrar l'nUp
     {
      null
     }repeat
    ]

%    M13 0 ne
%    {  %% aquí un nombre que potser inferior, igual o superior al nombre de pliegos per fer totes les pàgines
%     M13 nPliegOS ge
%     {  %% si és igual o superior, només avisem que es faran el mateixos llibrets dins el rang de pàgines del PDF d'entrada que s'hagin triat
