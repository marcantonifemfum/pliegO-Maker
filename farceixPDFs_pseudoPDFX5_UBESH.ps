 ] M2 get /ATmi exch def

 [  %% rutines d'escriptura i tabulació pel mapa d'imposició (mateixa tabulació equival a pàgines que poden treballar en doble)
  {  %% 0 treiem per pantalla el mapa d'imposició tipus un tall al mig sense desbarbar (Tarde Handbook)
   ([\n)print flush
   {  %% forall
    ( [\n)print flush
    0 1 15
    {
     dup dup 6 le
     {
      ATmi exch get
      {
       ( )print flush
      }repeat
      1 index exch get ==
     }
     {
      2 index exch get (  )print flush ==
      7 eq
      {
       (% - - - revers - - - \n)print flush
      }if
     }ifelse
    }for
    ( ]\n)print flush
   }forall
   (]\n)print flush
   pop
  }

  {  %% 1 treiem per pantalla el mapa d'imposició tipus cara i dors 1+1
