 MdL
 {
  1 pdfgetpage dup /Pdict exch def
 }
 {  %2% interroguem el MediaBox i el deixa a l'stack

%%UBESH el número de pàgina que processem ja ens arriba com una string
  Npgn  % cvx exec

%%ATENCIÓ: perquè el número de pàgina que ara ens ve NO ES CORRESPON al número de pàgina real del PDF que estem imposant (és el seqüencial d'imposició!)
%dup ==

%%Un truc per començar més enllà de la pàgina 1 del PDF
%4 add

%  pdfgetpage dup /Pdict exch def
 }ifelse

%%Hem detectat que en el llançat de PDFs que duen la clau /CropBox manen per sobre del comportament de /MediaBox al full d'imposició
%% anul·lant-la i aplicant el valor de la darrera pàgina que es llança ...de fet el /CropBox sempre mana sobre el /MediaBox
%% el problema està que dins el context de la imposició no queda blindat i actua sobre el /MediaBox del full (una consulta a gs-devel?)
%% llavors, abans d'anul·lar-lo, l'interroguem per saber si és ídem al /MediaBox de la pàgina que llancem dins l'nUp doncs, en cas de no ser igual
%% li haurem de corregir el seu posicionat LL activant un rectclip afegit que encaixi dins el LL/UR i redimensionat-lo dins el format de pàgina de l'nUP
%% ...com sigui, hem vist que via PDF scripting NO podem anar més enllà de la interrogació de dades doncs no ens permet modificar el contingut de diccionaris o streams
%% del PDF que estem llançant, just abans de pintar-lo, per aquest motiu hem d'executar CaLi2CoPi abans i filtrar/modificar el necessari
%% per exemple: hem de permetre imposar PDFs encriptats? signats? 

%pop
%dup /CropBox undef  %% de moment no en fa cas

%% aquesta interrogació directe pot fallar (veure 8CropBox_MediaBox_CropBox_NOMESaLarrelPage_pla.pdf) i necessitaria un loop ascendent per l'arbre de pàgines
%% doncs no podem assegurar que /MediaBox estigui al diccionari /Page degut a que és un valor que (com /CropBox) es pot heretar de més enrera o de l'arrel /Pages
% /MediaBox get  %% de la primera pàgina (no és un índex i per tant comença per 1!)
%2 pdfgetpage /MediaBox get  %% de la segona, etc

%% aquest valor ja l'haurem analitzat a FemFum_CaLi2CoPi_042_pliegOMakerUBESH.ps que és on hi tenim la rutina que explora l'arbre de pàgines eficientment 
%% caldrà saber si hem de fer cas al valor de CropBox, en cas que sigui diferent de MediaBox, i n'hi haurà prou en haver-lo eliminat
%% o haurem d'adaptar-nos al retall de CropBox activant un rectclip amb translació+escala

%%UBESH
%% per l'opció M7 del menú sabem si hem de respectar o no els valors del /CropBox, si existeix, en cas que sigui diferent de /MediaBox
%% el CropBox però, en cas d'exisitir, sempre l'eliminem com a paràmetre de cadascuna de les pàgines via FemFum_CaLi2CoPi_042_pliegOMakerUBESH.ps
%% estigui situat a on estigui, doncs és un valor heretable (com /MediaBox) i pot estar només a l'arrel de l'arbre /Pages o en qualsevol dels seus nodes
%% si /CropBox existeix i és diferent a /MediaBox en conservem els valors i els tornem a aplicar via rectclip quan s'activa la rutina controlada per /enQuadra 
M7
{  %% respectem els valors del /CropBox
 aMESaMES 0 eq
 {  %% explorem  els valors de les àrees desades
  XRay /PeDeEfa get
  M8 iLlibret get  %% vía índex (que es defineix i s'alimenta a nUp_pliegOS_UBESH.ps) tibem de M8 l'array del llibret que ara toca imposar
  3 -1 roll cvx exec 1 sub get  %% tibem, via índex del mapa d'imposició, el núm. de pàgina del PDF d'entrada que imposarem ara
  %% hem de contemplar el null de les pàgines en blanc! ...i què passa si treballem amb una array buida?
  dup null eq
  {  %% eliminem el null i el diccionari de pàgina per desactivar el gatell Simposa
   pop pop
   /Simposa false def
  }
  {
   /Simposa true def
   6 string cvs get

   dup /dpXRay exch def  %% diccionari amb les dades de la pàgina explorades a l'XRay de CaLi2CoPi

   %% segon ens cal saber si CropBox existeix
   dup /CropBox known
   {  %% si CropBox existeix
    %% tercer ens cal saber si MediaBox i CropBox són idèntics
    dup /CropBox get /_CB exch def
    /MediaBox get /_MB exch def
    /MBCBidem true def
    0 1 3
    {
     dup _CB exch get
     exch _MB exch get
     ne
     {
      /MBCBidem false def
      exit
     }if
    }for

%Npgn cvx exec 5 eq {_CB _MB MBCBidem (AveureSIvas)pstack quit}if

    MBCBidem
    {  %% SI ho són no fem res i ja és bo el valor de /MediaBox
     _MB
     /enQuadra false def
    }
    {  %% si NO ho són hem d'engegar l'operativa per moure i retallar l'àrea del /CropBox que ha de fer de /araMediaBox 
     _CB  %% el valor del CropBox ja ens serveix de nou MediaBox i només mancarà moure'l i retallar
     /enQuadra true def
    }ifelse
    /araMediaBox exch def
   }
   {  %% si CropBox no existeix no fem res i extraiem el valor del MediaBox per treballar
    /MediaBox get
    /enQuadra false def
    /araMediaBox exch def
   }ifelse
  }ifelse
 }
 {
  (\n\n >>> el gatell de CaLi2CoPi NO es l'adequat  ...sortim!\n\n)print flush stop
 }ifelse
}
{  %% com que no hem de respectar el /CropBox extraiem el valor del MediaBox per treballar
 XRay /PeDeEfa get

 M8 iLlibret get  %% vía índex (que es defineix i s'alimenta a nUp_pliegOS_UBESH.ps) tibem de M8 l'array del llibret que ara toca imposar
 3 -1 roll cvx exec 1 sub get  %% tibem, via índex del mapa d'imposició, el núm. de pàgina del PDF d'entrada que imposarem ara
 %% hem de contemplar el null de les pàgines en blanc! ...i què passa si treballem amb una array buida?
 dup null eq
 {  %% eliminem el null i el diccionari de pàgina per desactivar el gatell Simposa
  pop pop
  /Simposa false def
 }
 {
  /Simposa true def
  6 string cvs get
  dup /dpXRay exch def  %% diccionari amb les dades de la pàgina explorades a l'XRay de CaLi2CoPi
  /MediaBox get
  /enQuadra false def
  /araMediaBox exch def
 }ifelse
}ifelse

%%PRESERVEM l'estat gràfic abans de cap altre canvi d'escala/translació/rotació de cara als afegits post-llançat (numeració, etc) pàgina a pàgina
gsave

Simposa
{  %% el mapa d'imposició no ens torna un null (en blanc) o sigui que la imposem

 %% captura del valor Rotate per veure més endavant si cal aplicar-lo o no
 %% doncs aquí hauríem d'establir un mecanisme que permetés la tria de com imposar les pàgines del PDF d'entrada:
 %% amb la variable /aRaManA que capturarem de l'índex 0 de l'array del 3er índex del packedarray del mapa d'imposició, amb tres valors possibles:
 %% 1/ fent que mani MediaBox/CropBox (null) 2/ fent que mani Rotate (false) 3/ fent que s'adaptin de la millor manera a les pàgines del llançat (true)
 dpXRay /Rotate get /araRotate exch def  %% (HHHHH)pstack quit 

 %% deducció de l'escala de treball per adaptar al màxim cada pàgina del PDF que llegim a la pàgina del llançat
 %% es podria optar també per igualar els amples o alts de les pàgines que llegim al format de pàgina del llançat
 %% vegeu: igualatPerLaXmesAmplePossible.pdf i igualatPerLaYmesAltaPossible.pdf llegint 8auricsH.pdf i 8auricsV.pdf
 %% calculem el format de pàgina a partir del MediaBox de la pàgina que llegim
 araMediaBox aload pop 3 -1 roll sub abs exch 3 -1 roll sub abs exch  %% cal treballar amb el valor absolut!
 2 copy /YaImposar exch def /XaImposar exch def
 2 copy ge  %% el costat més gran o igual (quadrat) de la pàgina que llegim
 {  %% orientació horitzontal de la pàgina a imposar: l' X és el costat més gran
  /Odivisor false def
 }
 {  %% orientació vertical de la pàgina a imposar: l' Y és el costat més gran
  /Odivisor true def
 }ifelse

%%EP! a l'stack hi tenim l'x i la y de la pàgina a imposar

  %% quin és el costat més gran de la pàgina del llançat?
 xPagina yPagina gt
 {  %% l'orientació de la graella del llançat és horitzontal
%(l'orientacio de la graella del llancat es horitzontal)pstack quit
%%UBESH aquí podem veure quina mida i orientació tenen (V/H) els elements de la graella del llançat
%xPagina yPagina 2 array astore ==
%% aquí la mida i orientació de les pàgines a imposar
%XaImposar YaImposar 2 array astore ==

  M14 null eq  %% de com s'adapten les pàgines a la graella del llançat
  {  %% fem que mani el /MediaBox de cada pàgina del PDF a imposar
   (graella H del llancat / fem que mani el MediaBox)==  %pstack quit
   /encaixT [0 0] def
   /encaixR 0 def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem 
  }
  {
   M14
   {  %% fem que s'adapti a la pàgina del llançat H/H V/V de manera que si duu /Rotate i encaixa, ho respectarem, i si l'hem de forçar sempre serà a 90 en sentit horari
    %(adaptem MediaBox per la graella H)pstack quit
    Odivisor  %% true = la pàgina a imposar del PDF d'entrada és vertical | false = horitzontal
    {  %% si és vertical voldrà dir que només farem cas si duu Rotate 90 o -90
     araRotate  %% valor /Rotate de la pàgina a imposar del PDF d'entrada
     abs 90 eq
     {
      araRotate 0 gt
      {
       (graella H del llancat / pagina V amb Rotate +90 a imposar GIREM +90 contra sentit horari)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem 
       %% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
       /encaixT [0 yPagina] def
       /encaixR -90 def
      }
      {
       (graella H del llancat / pagina V amb Rotate -90 a imposar GIREM -90 sentit horari)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       %% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
       /encaixT [xPagina 0] def
       /encaixR 90 def
      }ifelse
     }
     {  %% duu Rotate 0/180/-180
      (graella H del llancat / pagina V amb Rotate 0/180/-180 a imposar GIREM -90 sentit horari)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
      %% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
      exch dup /YaImposar exch def 1 index /XaImposar exch def
      Odivisor not /Odivisor exch def
      /encaixT [0 yPagina] def
      /encaixR -90 def
     }ifelse
    }
    {  %% si és horitzontal voldrà dir que només farem cas d'un Rotate de 180 graus (positius o negatius) que ens capgirin la pàgina
     araRotate  %% valor /Rotate de la pàgina a imposar del PDF d'entrada
     abs 180 eq  %% visualment tant li fa que es capgiri 180 o -180
     {  %% definim els valors de translate i rotate per capgirar la pàgina
      (graella H del llancat / pagina H amb Rotate -180/180 CAPGIREM a 180)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
      /encaixT [xPagina yPagina] def
      /encaixR -180 def
     }
     {  %% potser duu rotate 90/-90/0, però deixem la pàgina tal i com està sense aplicar-lo
      (graella H del llancat / pagina H amb Rotate 90/-90/0 la deixem amb Rotate 0)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
      /encaixT [0 0] def
      /encaixR 0 def
     }ifelse
    }ifelse
   }
   {  %% fem que mani el valor /Rotate de cada pàgina del PDF a imposar
    %  (que mani Rotate per la graella H)pstack quit
    araRotate  %% valor /Rotate de la pàgina a imposar del PDF d'entrada
    0 eq
    {
(A mana Rotate a 0 per la graella del llancat H)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
     /encaixT [0 0] def
     /encaixR 0 def
    }
    {
     araRotate abs 90 eq
     {
      araRotate 0 lt
      {
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       (B mana Rotate a -90 per la graella del llancat H)==  %pstack quit
       %% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
       /encaixT [xPagina 0] def
       /encaixR 90 def
      }
      {
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       (C mana Rotate a +90 per la graella del llancat H)==  %pstack quit
       %% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
       /encaixT [0 yPagina] def
       /encaixR -90 def
      }ifelse
     }
     {
      araRotate 0 lt
      {
(D mana Rotate a -180 per la graella del llancat H)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       /encaixT [xPagina yPagina] def
       /encaixR -180 def
      }
      {
       (E mana Rotate a +180 per la graella del llancat H) ==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       /encaixT [xPagina yPagina] def
       /encaixR 180 def
       %% tant si la pàgina a imposar amb la rotació és vertical o horitzontal no ens cal definir res més
      }ifelse
     }ifelse
    }ifelse
   }ifelse
  }ifelse

  Odivisor
  {  %% però l'orientació de la pàgina a imposar és vertical
   exch pop yPagina exch div  %% escala de treball
  }
  {  %% però l'orientació de la pàgina a imposar és horitzontal o quadrada
   pop xPagina exch div  %% escala de treball
   %% ens cal saber si aquesta escala no fa que l'alt de la pàgina a imposar superi l'alt de que disposa el llançat
   dup YaImposar mul yPagina 2 copy gt
   {  %% corregim l'escala, doncs l'Y de la pàgina del PDF a imposar supera la Y de la pàgina del llançat
    YaImposar div  %% escala corregida
    exch pop exch pop
   }
   {  %% (NO hem de corregir l'escala)==  %pstack quit
    pop pop
   }ifelse
  }ifelse
%%EP! a l'stack hi tenim el valor de l'escala de la pàgina a imposar
 }
 {  %% l'orientació de la graella del llançat és vertical
  %(l'orientacio de la graella del llancat es vertical)pstack quit

%%UBESH aquí podem veure quina mida i orientació tenen (V/H) els elements de la graella del llançat
  %xPagina yPagina 2 array astore ==
  %% aquí la mida i orientació de les pàgines a imposar
  %XaImposar YaImposar 2 array astore ==

  M14 null eq  %% de com s'adapten les pàgines a la graella del llançat
  {  %% fem que mani el /MediaBox de cada pàgina del PDF a imposar
   (graella V del llancat / fem que mani el MediaBox)==  %pstack quit
   /encaixT [0 0] def
   /encaixR 0 def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
  }
  {
   M14
   {  %% fem que s'adapti a la pàgina del llançat H/H V/V de manera que si duu /Rotate i encaixa, ho respectarem, i si l'hem de forçar sempre serà a 90 en sentit horari
    Odivisor  %% true = la pàgina a imposar del PDF d'entrada és vertical | false = horitzontal
    {  %% si és vertical voldrà dir que només farem cas d'un Rotate de 180 graus (positius o negatius) que ens capgirin la pàgina
     araRotate  %% valor /Rotate de la pàgina a imposar del PDF d'entrada
     abs 180 eq  %% visualment tant li fa que es capgiri 180 o -180
     {  %% definim els valors de translate i rotate per capgirar la pàgina
      (graella V del llancat / pagina V amb Rotate -180/180 CAPGIREM a 180)==  %pstack quit
      /encaixT [xPagina yPagina] def
      /encaixR -180 def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
     }
     {  %% potser duu rotate 90/-90/0, però deixem la pàgina tal i com està sense aplicar-lo
      (graella V del llancat / pagina V amb Rotate 90/-90/0 la deixem amb Rotate 0)==  %pstack quit
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
      /encaixT [0 0] def
      /encaixR 0 def
     }ifelse
    }
    {  %% si és horitzontal voldrà dir que només farem cas d'un Rotate de 90 positiu (doncs per defecte sempre adreçarem la pàgina en sentit horari, o sigui -90)
     araRotate  %% valor /Rotate de la pàgina a imposar del PDF d'entrada
     abs 90 eq
     {
      araRotate 0 gt
      {
       (graella V del llancat / pagina H amb Rotate +90 a imposar GIREM +90 contra sentit horari)==  %pstack quit
%% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       /encaixT [0 yPagina] def
       /encaixR -90 def
      }
      {
       (graella V del llancat / pagina H amb Rotate -90 a imposar GIREM -90 sentit horari)==  %pstack quit
%% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       /encaixT [xPagina 0] def
       /encaixR 90 def
      }ifelse
     }
     {  %% duu Rotate zero
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
      2 copy eq  %% el MediaBox o el retallador CropBox és quadrat?
      {  %% és quadrada i llavors deixem els valors de translate, rotate, XaImposar/YaImposar i Odivisor intactes
       /encaixT [0 0] def
       /encaixR 0 def
      }
      {  %% només el girem si és horitzontal
       XaImposar YaImposar gt
       {  %% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
        exch dup /YaImposar exch def 1 index /XaImposar exch def
        /encaixT [0 yPagina] def  %% quedarà arranat a la part de dalt de la pàgina
        /encaixR -90 def
        Odivisor not /Odivisor exch def
        %(elGIREM)==
       }
       {  %% deixem els valors de translate, rotate i XaImposar/YaImposar intactes
        /encaixT [0 0] def
        /encaixR 0 def
       }ifelse
      }ifelse
      %(graella V del llancat / pagina H amb Rotate 0 a imposar GIREM -90 sentit horari, tret que sigui quadrada i no la toquem)pstack quit
     }ifelse
    }ifelse
   }
   {  %% fem que mani el valor /Rotate de cada pàgina del PDF a imposar
    araRotate  %% valor /Rotate de la pàgina a imposar del PDF d'entrada
    0 eq
    {
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
(1 mana Rotate a 0 per la graella del llancat V)==  %pstack quit
     %% deixem els valors de translate, rotate i XaImposar/YaImposar intactes
     /encaixT [0 0] def
     /encaixR 0 def
    }
    {
     araRotate abs 90 eq
     {
      araRotate 0 lt
      {
(2 mana Rotate a -90 per la graella del llancat V)==  %pstack quit
%% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       /encaixT [xPagina 0] def
       /encaixR 90 def
      }
      {
(3 mana Rotate a +90 per la graella del llancat V)==  %pstack quit
%% capgirem els valors XaImposar/YaImposar i Odivisor i el girem -90 sentit horari
       exch dup /YaImposar exch def 1 index /XaImposar exch def
       Odivisor not /Odivisor exch def
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
       /encaixT [0 yPagina] def
       /encaixR -90 def
      }ifelse
     }
     {
      araRotate 0 lt
      {
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
(4 mana Rotate a -180 per la graella del llancat V)==  %pstack quit
       /encaixT [xPagina yPagina] def
       /encaixR -180 def
      }
      {
%%UEP hem de pensar que més endavant hi haurem d'afegir un possible corrector de rotació que ens vindrà quan implementem les packedarrays per pàgina
%%UN altre element compensatori, quan algun dels 4 costats no toqui vores a la graella del llançat, seria decidir a quina de les vores on no toca l'ajustem o centrem
(5 mana Rotate a +180 per la graella del llancat V)==  %pstack quit
       /encaixT [xPagina yPagina] def
       /encaixR 180 def
      }ifelse
     }ifelse
    }ifelse
   }ifelse
  }ifelse

  Odivisor
  {  %% i l'orientació de la pàgina a imposar també és vertical
   exch pop yPagina exch div  %% escala de treball
   %% ens cal saber si aquesta escala no fa que l'ample de la pàgina imposada superi encara la que disposa el llançat
   dup XaImposar mul xPagina 2 copy gt
   {  %% corregim l'escala, doncs l'X encara NO encaixa dins la pàgina del llançat
(corregim l'escala / pagina a imposar en Vertical)==
    XaImposar div  %% escala corregida
    exch pop exch pop
   }
   {
(NO hem de corregir l'escala / pagina a imposar en Vertical)==  %pstack quit
    pop pop
   }ifelse
  }
  {  %% però l'orientació de la pàgina a imposar és horitzontal o quadrada
   pop xPagina exch div  %% escala de treball
%% ens cal saber si aquesta escala no fa que l'alt de la pàgina imposada superi encara la que disposa el llançat
   dup YaImposar mul yPagina 2 copy gt
   {  %% corregim l'escala, doncs l'Y encara NO encaixa dins la pàgina del llançat
    YaImposar div  %% escala corregida
    exch pop exch pop
(corregim l'escala / pagina a imposar en Horitzontal)==
   }
   {  %% (NO hem de corregir l'escala)==  %pstack quit
(NO hem de corregir l'escala / pagina a imposar en Horitzontal)==  %pstack quit
    pop pop
   }ifelse
%%REpublica: abans activavem un error però creiem que NO ho es doncs es tractaria d'una pagina completament quadrada
  }ifelse
%%EP! a l'stack hi tenim el valor de l'escala de la pàgina a imposar
 }ifelse  %%  graella del llançat horitzontal/vertical

 %% fem aquí els translate/rotate que toquin abans d'escalar
 encaixT aload pop translate encaixR rotate

 dup /araScl exch def
 dup scale  %% adapta al màxim cada pàgina del PDF que llegim dins la pàgina del llançat segons M14
 %% ídem si escalem via matriu
 %[ exch 0 0 2 index 0 0 ] concat


%%UBESH
 enQuadra
 {  %% només si hi ha CropBox actiu diferent de MediaBox
  %% la translació i el retall l'hem de fer per aquest ordre
  araMediaBox dup aload pop

  %% contemplem totes les possibles orientacions del retall SO/NE NO/SE NE/SO SE/NO
  3 -1 roll 2 copy lt
  {
   pop
  }
  {
   exch pop
  }ifelse neg  %% valor Y del translate ha de ser el més petit de les dues
  3 1 roll 2 copy lt
  {
   pop
  }
  {
   exch pop
  }ifelse neg  %% valor X del translate ha de ser el més petit de les dues
  exch translate
  aload pop 2 index sub exch 3 index sub exch

%   Npgn cvx exec 5 eq {araMediaBox araScl (***)pstack quit}if

  rectclip
 }if

}if  %% Simposa ?


 MdL
 {

%%TEST
%pedeefa Context1 .PDFStream
%(<<<<)pstack
%%Brossa d'un diccionari Info?
%{== ==}forall %(<<<<)pstack
% quit

  %%Pàgina -1 com a índex
  Context1 0 .PDFDrawPage  %% repiquem la pàgina Npgn però cridada com a índex
%  Context1 .PDFClose
%  runpdfend
%  elF closefile

 }
 { %% primer mètode de pintar la pàgina

%%Pàgina Npgn -1 com a índex

   Npgn cvx exec
%%Un truc per començar més enllà de la pàgina 1 del PDF
%4 add
   1 sub


%%Scripting 3
%false
%{
% Context1 exch .PDFDrawPage  %% imposem la pàgina Npgn però cridada com a índex i que hem tibat de M8
%}
%{
%%UBESH un cop tinguem l'OK del mapa/array d'imposició revisat a ?, serà aquí on farem les crides al mapa d'imposició
%% és aquí on procedim a fer jugar em mapa/array d'imposició
   M8 length 0 eq

   {
    /llançat true def
   }
   {
    %% araLlibret  %% array del llibret, extret de M8, que ara toca imposar
    %% ATENCIÓ: òbviament l'índex de l'array del llibret i el número de pàgina del PDF d'entrada no tenen perquè coincidir!
    M8 iLlibret get  %% vía índex (que es defineix i s'alimenta a nUp_pliegOS_UBESH.ps) tibem de M8 l'array del llibret que ara toca imposar
%(MATRIUcorregida?)pstack quit

    exch get  %% tibem, via índex del mapa d'imposició, el núm. de pàgina del PDF d'entrada que imposarem ara

%dup ==

    %% si ens arriba un null equival a una pàgina en blanc i evitem el .PDFDrawPage
    dup null eq
    {
     pop
     /llançat false def
    }
    {
     1 sub  %% però el retornem al seu índex per fer el .PDFDrawPage

%%ENUMERA pàgines
dup /iDoE exch def  %% l'índex de pàgina en el sentit de lectura ens detectarà pàgines a dreta/esquerra en el sentit de lectura? segurament no serà valid per alguns nUps

     /llançat true def
    }ifelse
   }ifelse

%% metode per eliminar el /CropBox?
%%   Context1 1 index .PDFPageInfo /CropBox undef  %% NO rutlla

     llançat  %% quin tipus de pàgina llancem?
     {  %% imposem la pàgina segons l'índex capturat a M8
   %1% deixa una instància oberta a memòria sense cap objecte a l'stack que permet anar interrogant
%   pedeefa (r) file dup /elF exch def runpdfbegin  %% cal tancar-la amb runpdfend al final
   %3% inicialitzem per intervenir dins l'estructura del pdf, afegint noves branques de dades, com la dels formularis
%   /Context1 .PDFInit def
%   pedeefa Context1 .PDFFile

%false
%{
%%Scripting 2
% elF runpdfbegin  %% inicialitzem el fitxer PDF
% 1 add pdfgetpage  %% agafa les dades de la pàgina i en deixa el seu diccionari a l'stack però aquí NO pas com a índex!
% pdfshowpage  %% pren el diccionari de pàgina i executa showpage
% runpdfend  %% tanca el procés


%}
%{
%%Scripting 1
      Context1 exch .PDFDrawPage  %% imposem la pàgina Npgn però cridada com a índex i que hem tibat de M8
%%Hauríem d'explorar el comportament de /BeginPage /EndPage en relació a aquesta crida de l'scripting doncs es comporta de forma erràtica treballant amb pàgines en blanc
%% doncs si no va acompanyada d'una segona crida a un PDF buit /Context2 no les situa allà on tocaria
%}ifelse
      %matrix currentmatrix ==
     }
     {  %% pàgina en blanc
%false
%{
%%Scripting 2
%}
%{
%%Scripting 1
      %% imposem una pàgina (la 9) que fa de blanc teòric
      %% hem vist que el mètode demana que dugui text o imatge, doncs amb vectorials no ens fa cas
      %Context1 8 .PDFDrawPage

%% per què el text/tipografia dóna recursos a .PDFDRawPage per situar-se en el lloc correcte i una imatge o un vectorial NO?
      Context2 0 .PDFDrawPage

%}ifelse

%gsave
%1 1 1 setrgbcolor
%0 0 xPagina yPagina rectfill
%grestore
     }ifelse
%}ifelse
%%Scripting 3

%grestore

  %% segon mètode per pintar la pàgina
  % Pdict  %{== ==}forall (||||)== quit  %% pdfshowpage

%  Context1 .PDFClose
%  runpdfend

%  elF closefile

%% no ajuda a millorar?
%initgraphics
%initmatrix
%grestoreall
 }ifelse

%%PRESERVEM l'estat gràfic abans de cap altre canvi d'escala/translació/rotació de cara als afegits post-llançat (numeració, etc) pàgina a pàgina
grestore

%}stopped
%{
% (\n\n >>> farceixPDFs_pseudoPDFX5_UBESH ON PETES?\n\n) print flush (- - - - - - - - - -)pstack stop
%}if

%%ENUMERA pàgines
 %% aquest és el punt on millor podem fer aquesta feina?
 %% que la basarem en l'estratègia de compondre el numeral que toqui en base al mapa d'imposició (però ara ho fa via Npgn)
 %% doncs l'usuari podrà haver omès el dígit del número de pàgina (pàgina sense numerar) o haver-lo personalitzat o forçar a una pàgina en blanc que es numeri
 %% gràficament jugarem amb una base geomètrica: quadrat, triangle, semicercle, amb un factor de transparència que podrà ser inicalment gris o negre
 %% el valor del numeral el posarem inicialment en blanc opac (podríem posar tots dos elements en una capa de PDF desactivable per l'usuari a l'imprimir?)

 %% per defecte NO numerem les pàgines en blanc
 %% aquí ja no quedem afectats pels paràmetres d'escala/translació/rotació particulars de cada pàgina del llançat

 M15 0 get  %% opció de menú
 {
  llançat  %% la pàgina en blanc NO la numerem ara
  {
   iDoE  %% haurem de pescar el numèric a pintar del mapa d'imposició
   1 add 2 mod 0 eq  %% primer ens cal saber si estem fent una pàgina de la dreta o de l'esquerra (imparells/parells?)
   {  %% esquerra és sempre parell?
    false
   }
   {  %% dreta és sempre imparell?
    true
   }ifelse
   /Pesquerra exch def  %% gatell per controlar les pàgines esquerra/dreta (hem de concretar l'estratègia per detectar-les en base al mapa d'imposició segons l'nUp triat)
   /PXV M15 1 get def  %% 0 peu, 1 xamfrà, 2 vora, posició del numerador dins la pàgina haurà de ser una opció de menú
   /PoT M15 2 get def  %% false ple, true transparent, haurà de ser una opció de menú 
   /QCT M15 3 get def  %% 0 cap, 1 quadrat, 2 semicercle, 3 triangle, # dymo?: quin fons hi posem al numerador? haurà de ser una opció de menú
   /cQCT M15 4 get def  %% 0 cap, 1 negre, 2 gris, quin color de fons hi posem al numerador? haurà de ser una opció de menú

   [  %% configurem els tres modes per situar i enumerar
    {  %% 0 centrat al peu de pàgina
     gsave  %% preservem la transparència, si n'hi ha, i el color de fons del numerat
     xPagina yPagina lt
     {
      xPagina 15 div /cCub exch def  %% una # part del costat més petit?
     }
     {
      yPagina 15 div /cCub exch def  %% una # part del costat més petit?
     }ifelse

     PoT  %% ple o transparent com a opció de menú
     {
      %% /Multiply .setblendmode .2 .setopacityalpha  %% han quedat obsolets des del GS 9.53
      %% activar la transparència ens obliga a incloure el gatell -dALLOWPSTRANSPARENCY dins la línia de comanda d'execució
      true .setalphaisshape .4 .setfillconstantalpha
     }if

     [  %% color de la forma del fons del numerador
      {  %% 0 cap
       %% dymo?
      }
      {  %% 1 negre
       0 0 0 setrgbcolor
      }
      {  %% 2 gris
       .7 .7 .7 setrgbcolor
      }
     ] cQCT get cvx exec  %% opció de menú?

     [  %% forma del fons del numerador
      {  %% 0 cap
      }
      {  %% 1 quadrat
       xPagina 2 div cCub 2 div sub 0 cCub dup 4 copy rectfill
       pop 2 index add 0 cCub 2 div 5 array astore /LdBiC exch def  %% línia de base i cos teòrics
      }
      {  %% 2 semicercle
       xPagina 2 div 0 cCub 2 div 0 360 arc
       pathbbox cCub 2 div 5 array astore /LdBiC exch def  %% línia de base i cos teòrics
       fill
      }
      {  %% 3 triangle
       cCub 2 sqrt mul 2 div dup dup xPagina 2 div dup dup 4 -1 roll sub 0 moveto 3 -1 roll lineto add 0 lineto closepath
       pathbbox 2 index exch 5 array astore /LdBiC exch def  %% línia de base i cos teòrics
       fill
      }
     ] QCT get cvx exec  %% opció de menú
     grestore  %% preservem la transparència, si n'hi ha, i el color de fons del numerat
    }  %% 0 centrat al peu de pàgina

    {  %% 1 al xamfrà esquerra o dreta
     gsave  %% preservem la transparència, si n'hi ha, i el color de fons del numerat
     xPagina yPagina lt
     {
      xPagina 15 div /cCub exch def  %% una # part del costat més petit?
     }
     {
      yPagina 15 div /cCub exch def  %% una # part del costat més petit?
     }ifelse

     PoT  %% ple o transparent com a opció de menú
     {
      %% /Multiply .setblendmode .2 .setopacityalpha  %% han quedat obsolets des del GS 9.53
      %% activar la transparència ens obliga a incloure el gatell -dALLOWPSTRANSPARENCY dins la línia de comanda d'execució
      true .setalphaisshape .4 .setfillconstantalpha
     }if

     [  %% color de la forma del fons del numerador
      {  %% 0 cap
      }
      {  %% 1 negre
       0 0 0 setrgbcolor
      }
      {  %% 2 gris
       .7 .7 .7 setrgbcolor
      }
     ] cQCT get cvx exec  %% opció de menú?

     [  %% forma del fons del numerador
      {  %% 0 cap
       %% dymo?
      }
      {  %% 1 quadrat
       Pesquerra
       {  %% pàgina dreta?
	xPagina cCub sub 0 cCub dup 4 copy rectfill
        pop 2 index add 0 cCub 2 div true 6 array astore /LdBiC exch def  %% línia de base i cos teòrics
       }
       {  %% pàgina esquerra?
	0 0 cCub dup 4 copy rectfill
        pop 2 index add 0 cCub 2 div false 6 array astore /LdBiC exch def  %% línia de base i cos teòrics
       }ifelse
      }
      {  %% 2 semicercle
       Pesquerra
       {  %% pàgina dreta?
        xPagina 0 cCub 0 360 arc
        pathbbox cCub 2 div true 6 array astore /LdBiC exch def  %% línia de base i cos teòrics
	fill
       }
       {  %% pàgina esquerra?
        0 0 cCub 0 360 arc
        pathbbox cCub 2 div false 6 array astore /LdBiC exch def  %% línia de base i cos teòrics
	fill
       }ifelse
      }
      {  %% 3 triangle
       Pesquerra
       {  %% pàgina dreta?
        xPagina 0 moveto xPagina cCub 2 sqrt mul lineto xPagina cCub 2 sqrt mul sub 0 lineto closepath
        pathbbox dup true 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a la dreta
	fill
       }
       {  %% pàgina esquerra?
        0 0 moveto 0 cCub 2 sqrt mul lineto cCub 2 sqrt mul 0 lineto closepath
        pathbbox dup false 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a l'esquerra
	fill
       }ifelse
      }
     ] QCT get cvx exec  %% opció de menú
     grestore  %% preservem la transparència, si n'hi ha, i el color de fons del numerat
    }  %% 1 al xamfrà esquerra o dreta

    {  %% 2 centrat verticalment a la vora esquerra o dreta
     gsave  %% preservem la transparència, si n'hi ha, i el color de fons del numerat
     xPagina yPagina lt
     {
      xPagina 15 div /cCub exch def  %% una # part del costat més petit?
     }
     {
      yPagina 15 div /cCub exch def  %% una # part del costat més petit?
     }ifelse

     PoT  %% ple o transparent com a opció de menú
     {
      %% /Multiply .setblendmode .2 .setopacityalpha  %% han quedat obsolets des del GS 9.53
      %% activar la transparència ens obliga a incloure el gatell -dALLOWPSTRANSPARENCY dins la línia de comanda d'execució
      true .setalphaisshape .4 .setfillconstantalpha
     }if

     [  %% color de la forma del fons del numerador
      {  %% 0 cap
      }
      {  %% 1 negre
       0 0 0 setrgbcolor
      }
      {  %% 2 gris
       .7 .7 .7 setrgbcolor
      }
     ] cQCT get cvx exec  %% opció de menú?

     [  %% forma del fons del numerador
      {  %% 0 cap
       %% dymo?
      }
      {  %% 1 quadrat
       Pesquerra
       {  %% pàgina dreta?
        xPagina cCub sub yPagina 2 div cCub 2 div sub cCub dup
	4 copy dup true 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a la dreta
	rectfill
       }
       {  %% pàgina esquerra?
        0 yPagina 2 div cCub 2 div sub cCub dup
	4 copy dup false 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a l'esquerra
	rectfill
       }ifelse
      }
      {  %% 2 semicercle
       Pesquerra
       {  %% pàgina dreta?
        xPagina yPagina 2 div 2 copy cCub 2 div 0 360 arc
	pathbbox pop true 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a la dreta
	fill
       }
       {  %% pàgina esquerra?
        0 yPagina 2 div 2 copy cCub 2 div 0 360 arc
        pathbbox pop false 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a l'esquerra
	fill
       }ifelse
      }
      {  %% 3 triangle
       Pesquerra
       {  %% pàgina dreta?
        xPagina cCub 2 sqrt mul 2 div sub yPagina 2 div moveto
	xPagina yPagina 2 div cCub 2 sqrt mul 2 div sub lineto
	xPagina yPagina 2 div cCub 2 sqrt mul 2 div add lineto closepath
        pathbbox dup true 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a la dreta
	fill
       }
       {  %% pàgina esquerra?
        0 cCub 2 sqrt mul 2 div add yPagina 2 div moveto
	0 yPagina 2 div cCub 2 sqrt mul 2 div sub lineto
	0 yPagina 2 div cCub 2 sqrt mul 2 div add lineto closepath
        pathbbox dup false 6 array astore /LdBiC exch def  %% línia de base i cos teòrics a l'esquerra
	fill
       }ifelse
      }
     ] QCT get cvx exec  %% opció de menú
     grestore  %% preservem la transparència, si n'hi ha, i el color de fons del numerat
    }  %% 2 centrat verticalment a la vora esquerra o dreta
   ]  %% configurem els tres modes per situar i enumerar

   PXV get cvx exec  %% nova opció de menú pel posicionat del numerador dins la pàgina

   %% pintem en blanc opac el numèric
   gsave
   0 0 0 0 setcmykcolor
   (/usr/share/fonts/truetype/hack/Hack-Regular.ttf) findfont /dfNum exch def
   [
    {  %% 0 al peu
     [
      {  %% 0 cap
%% dymo?
      }
      {  %% 1 quadrat
       LdBiC aload pop dfNum exch scalefont setfont
       pop 2 index sub 2 div
       0 0 moveto Npgn stringwidth pop 2 div sub 3 -1 roll add exch pop cCub .3 mul moveto Npgn show
      }
      {  %% 2 semicercle
       LdBiC aload pop dfNum exch .7 mul scalefont setfont
       pop 2 index sub 2 div
       0 0 moveto Npgn stringwidth pop 2 div sub 3 -1 roll add exch pop cCub .1 mul moveto Npgn show
      }
      {  %% 3 triangle
       LdBiC aload pop dfNum exch .7 mul scalefont setfont
       pop 2 index sub 2 div
       0 0 moveto Npgn stringwidth pop 2 div sub 3 -1 roll add exch pop cCub .1 mul moveto Npgn show
      }
     ] QCT get cvx exec
    }

    {  %% 1 al xamfrà
     [
      {  %% 0 cap
%% dymo?
      }
      {  %% 1 quadrat
       LdBiC aload pop
       {  %% xamfrà dret
        dfNum exch scalefont setfont
        pop 2 index sub 2 div
        0 0 moveto Npgn stringwidth pop 2 div sub 3 -1 roll add exch pop cCub .3 mul moveto Npgn show
       }
       {  %% xamfrà esquerre
        dfNum exch scalefont setfont
        pop 2 index sub 2 div
        0 0 moveto Npgn stringwidth pop 2 div sub 3 -1 roll add exch pop cCub .3 mul moveto Npgn show
       }ifelse
      }
      {  %% 2 semicercle
       LdBiC aload pop
       {  %% xamfrà dret
        dfNum exch .9 mul scalefont setfont
        xPagina	0 translate 45 rotate
	0 0 moveto Npgn stringwidth pop 2 div neg exch .5 mul moveto
	Npgn show
	pop pop pop
       }
       {  %% xamfrà esquerre
        dfNum exch .9 mul scalefont setfont
        0 0 translate -45 rotate
	0 0 moveto Npgn stringwidth pop 2 div neg exch .5 mul moveto
	Npgn show
	pop pop pop
       }ifelse
      }
      {  %% 3 triangle
       LdBiC aload pop
       {  %% xamfrà dret
        dfNum exch .4 mul scalefont setfont
        xPagina	0 translate 45 rotate
	0 0 moveto Npgn stringwidth pop 2 div neg exch .3 mul moveto
	Npgn show
	pop pop pop
       }
       {  %% xamfrà esquerre
        dfNum exch .4 mul scalefont setfont
        0 0 translate -45 rotate
	0 0 moveto Npgn stringwidth pop 2 div neg exch .3 mul moveto
	Npgn show
	pop pop pop
       }ifelse
      }
     ] QCT get cvx exec
    }

    {  %% 2 a la vora
     [
      {  %% 0 cap
%% dymo?
      }
      {  %% 1 quadrat
       LdBiC aload pop
       {  %% vora dreta
        dfNum exch .5 mul dup /araCos exch def scalefont setfont
	2 div exch 2 div 4 -1 roll add exch 3 -1 roll add exch
	0 0 moveto Npgn stringwidth pop 2 div sub exch araCos 3 div sub
	moveto Npgn show
       }
       {  %% vora esquerra
        dfNum exch .5 mul dup /araCos exch def scalefont setfont
	2 div exch 2 div 4 -1 roll add exch 3 -1 roll add exch
	0 0 moveto Npgn stringwidth pop 2 div sub exch araCos 3 div sub
	moveto Npgn show
       }ifelse
      }
      {  %% 2 semicercle
       LdBiC aload pop
       {  %% vora dreta
        exch pop exch sub
	dfNum exch dup 2 div /araR exch def .3 mul scalefont setfont
	translate araR 2 div 0 0 moveto Npgn stringwidth pop
        2 div add neg araR .15 mul neg moveto Npgn show
       }
       {  %% vora esquerra
        exch pop exch sub
	dfNum exch dup 2 div /araR exch def .3 mul scalefont setfont
	translate araR 2 div 0 0 moveto Npgn stringwidth pop
        2 div sub araR .15 mul neg moveto Npgn show
       }ifelse
      }
      {  %% 3 triangle
       LdBiC aload pop
       {  %% vora dreta
        3 index sub dfNum exch .25 mul dup /araCos exch def scalefont setfont
        2 index sub 2 div 3 -1 roll add exch 2 index sub 2 div 3 -1 roll add
	0 0 moveto Npgn stringwidth pop 2 div sub exch araCos 3 div sub
	moveto Npgn show
       }
       {  %% vora esquerra
        3 index sub dfNum exch .25 mul dup /araCos exch def scalefont setfont
        2 index sub 2 div 3 -1 roll add exch 2 index sub 2 div 3 -1 roll add
	0 0 moveto Npgn stringwidth pop 2 div sub exch araCos 3 div sub
	moveto Npgn show
       }ifelse
      }
     ] QCT get cvx exec
    }
   ] PXV get cvx exec
   grestore
  }if  %% pàgina en blanc?
 }if  %% enumerem les pàgines?

}if  %% noNULL anellem el codi sencer perquè no és aleatori per pàgina

