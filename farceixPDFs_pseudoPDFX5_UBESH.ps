%% Malgrat NO sigui l'estructura de treball que necessita pliegO'Maker: el mapa d'imposició quan és encartat s'entén millor encaixat?
%dup ==

    %% per tal de generar d'una forma continuada l'ordre del dúplex anvers/revers que hauria de tenir el PDF resultant
    /aDesencartar exch def  %% array que desencartem
    [
     {  %% loop
      /NOhiHAarray true def  %% gatell per saber si hi ha un nou array aniuat, quan torni a ser true sortirem del loop
      [
       aDesencartar
       {  %% forall
        dup type /arraytype eq
        {
         /aDesencartar exch def
         /NOhiHAarray false def  %% n'hi ha 1 a dins!
        }
        {  %% no fem res i deixem l'element a l'stack
        }ifelse
       }forall
      ]  %% quedarà a l'stack una array desencartada darrera l'altre

      NOhiHAarray
      {  %% sortim quan no n'hagi trobat cap
       exit
      }if
     }loop
    ]  %% aquesta array duu un llibret (array) al costat de l'altre
   }
   {  %% endrecem l'aplilat agrupant per ordre en arrays els llibrets

%% Malgrat NO sigui l'estructura de treball que necessita pliegO'Maker: el mapa d'imposició quan és apilat tampoc no s'entén millor mostrant les pàgines seguides
%dup ==
    nPliegOS cvi /nLlibrets exch def

    /Arrangem exch def
    /i 0 def
    [
     nLlibrets
     {
      Arrangem i Nup 2 mul getinterval
      i Nup 2 mul add /i exch def
     }repeat
    ]
   }ifelse
   /M8 exch def
  }ifelse
 }
