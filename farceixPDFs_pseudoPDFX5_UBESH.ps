M10
{  %% NO fem el llançat i només generem el mapa d'imposició en base al nombre de pàgines del PDF i l'enquadernat triat
 mapaDimposicio /ARArray exch def
 nqdrnt null eq
 {  %% 1 sol llibret de pàgines seguides (apilat) fins que s'esgoti l'nUp
  poPDF Nup 2 mul sub
  dup 0 lt  %% el nombre de pàgines del PDF d'origen és més petit que el nombre de pàgines d'1 nUp?
  {  %% evitem negatius quan hi ha menys pàgines que el total d'1 nUp
   pop 0
  }if
  /Pignorades exch def
 }
 {
  /ignorades poPDF 1 add array def  %% el total de NULLs -1 que hi hagin en aquesta array serà el nombre de pàgines ignorades
  {  %% loop
   /sorTim true def
   ARArray  %% explorem la còpia del mapa d'imposició que ha estat generat per la rutina que treballa els 3 tipus d'enquadernat
%% el fet que en aquesta array hi pot haver una numeració de pàgines que ja no comenci per 1 i que pot ser de qualsevol tram correlatiu
%% fa que ens haguem de plantejar una nova estratègia per detectar possibles pàgines ignorades
%% l'estratègia seria fondre ARArray dins de la carcassa matriu possible de totes les pàgines del PDF i a partir d'aquí comptar NULLs
   {  %% forall
    dup type /nulltype eq
    {
     pop
    }
    {
     dup type /arraytype eq
     {
      /ARArray exch def
      /sorTim false def
     }
     {  %% filtrem les repeticions
      dup ignorades 3 1 roll put
     }ifelse
    }ifelse
   }forall
   sorTim
   {
    exit
   }if
  }loop
  /Pignorades -1 def
  ignorades
  {  %% comptem null
   null eq
   {
    Pignorades 1 add /Pignorades exch def
   }if
  }forall
 }ifelse
}
{  %% com que no és un assaig i ja fem el llançat del PDF, el número de pàgines ignorades és
 poPDF pPDF sub /Pignorades exch def
}ifelse
%% nombre de pàgines del PDF a imposar que no figuren al mapa d'imposició, llavors les repeticions no compten
