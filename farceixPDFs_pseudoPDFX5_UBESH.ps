 %% comencem filtrant si quadren el nombre d'elements a les arrays en relació a l' nUp triat (avisem de les correccions i continuem)
 [
  M8
  {  %% forall
   dup length Nup 2 mul ne
   {  %% el nombre de pàgines d'1 llibret no coincideix amb el nombre de pàgines de l'array del mapa d'imposició?
    dup length Nup 2 mul exch sub dup 0 lt
    {  %% en negatiu vol dir que hi ha més pàgines del compte i hem d'escapçar l'array
     abs 4 string cvs /elm exch def 0 Nup 2 mul getinterval  %% i ho fem per la cua
     (\n\n >>>> escurcem... ) print flush elm print flush ( ...pagines d'un dels llibrets doncs supera el maxim de l'enquadernat que heu triat\n\n)print flush
    }
    {  %% si és positiu, és el nombre de pàgines en blanc (null) que hi hem d'afegir
     dup 4 string cvs /apeb exch def 1 index length add array dup 3 -1 roll 0 exch putinterval  %% també per la cua
     (\n\n >>>> afegim... ) print flush apeb print flush
     ( ...pagines en blanc en un dels llibrets doncs no arriba al nombre de pagines de l'enquadernat que heu triat\n\n)print flush
    }ifelse
   }if
  }forall
 ]
 /M8 exch def

