%%REpublica cal retornar el nom del PDF repicat per CaLi2CoPi
%%URLUBESH
%% com ho fem perquè els noms dels PDFs 1 o + arribin dins una array?
bateiG
%(UUUIIII)pstack quit
   /pedeefa exch def

%%UBESH
%% Ara treballem amb 1 sol PDF d'entrada que generarà 1 sol PDF de sortida (cada 2 planes del PDF resultant, anvers/revers, serà 1 pliegOS)
%%+1 cal saber quantes pàgines té el PDF d'entrada a imposar
aPmaker  %% aquest paquet desat per CaLi2CoPi duu tantes arrays com pàgines amb els valors del CropBox, en cas d'existir, i si no del MediaBox
length /pPDF exch def
%%+2 cal saber quin nUp hem triat
M2 /Nup exch def
%%+3 cal saber quin enquadernat hem triat
M9  %% null = fem 1 sol llibret de pàgines seguides fins a esgotar l'nUp (si falten pàgines s'omplen amb buides a la cua i si en sobren es talla)
       %% true = encartem amb tants llibrets com pàgines tingui el PDF i l'nUp triat (si falten pàgines s'omplen amb buides a la cua)
       %% false = apilem amb tants llibrets com pàgines tingui el PDF i l'nUp triat (si falten pàgines s'omplen amb buides a la cua)
/nqdrnt exch def

%%UBESH
%%M10 ASSAGEM EL MAPA D'IMPOSICIÓ?
%% true = si assagem el mapa d'imposició no crearem el PDF amb el pliegOS i només donarem com a resultat una matriu per a M8
%% false = aplicarem el mapa d'imposició definit a M8 i generarem el PDF amb el pliegOS
%% un cop generat l'array del mapa d'imposició automàticament, haurà de ser l'usuari de pliegOS qui l'ajusti manualment si li cal
M10
{  %% NO fem el llançat i només generem el mapa d'imposició en base al nombre de pàgines del PDF i l'enquadernat triat

%%UBESH sedassem | garbellem | destriem
%(\n\n | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |\n)print flush
%(\n\n - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n)print flush
%(\n\n + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +\n)print flush
%(\n\n ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~\n)print flush
(\n\n / / / / / / / / / / / / / / / / / / / / / / / / / / / / / /\n)print flush
( \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \n\n)print flush
(                s   e   d   a   s   s   e   m\n)print flush
(\n \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \n)print flush
( / / / / / / / / / / / / / / / / / / / / / / / / / / / / / /\n)print flush
%( ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~\n\n)print flush
%( + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +\n\n)print flush
%( - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n\n)print flush
%( | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |\n\n)print flush

 %% aquesta rutina genera mapes d'imposició en els 3 tipus d'enquadernat:
 nqdrnt null eq
 {  %% 1 sol llibret de pàgines seguides fins que s'esgoti l'nUp (si falten pàgines s'omplen amb buides a la cua i si en sobren es talla)
  [
   1 1  %% comencem per la 1 sumant 1
   Nup 2 mul pPDF sub
   dup 0 eq
   {  %% el PDF d'entrada quadra exactament amb el nombre de pàgines de l'nUp triat
    pop pPDF
    /enBlanc 0 def
   }
   {
    dup 0 gt
    {  %% el PDF d'entrada té MENYS pàgines que l'nUp triat
     /enBlanc exch def
     pPDF
    }
    {  %% el PDF d'entrada té MÉS pàgines que l'nUp triat
     pop /enBlanc 0 def
     Nup 2 mul
    }ifelse
   }ifelse

   {
   }for

   enBlanc
   {
    null
   }repeat
  ]
  /mapaDimposicio exch def
 }
 {  %% tants llibrets com faci falta fins a esgotar les pàgines del PDF d'entrada per l'nUp triat
  nqdrnt  %% true = encartat | false = apilat
  {  %% encartem els pliegOS
   [  %% inici de l'array d'imposició
   pPDF Nup 2 mul sub  %% nombre de pàgines a part el llibret central
   dup 0 eq
   {  %% no hi haurà encartat perquè només dóna per 1 llibret exacte
    pop
    1 1 pPDF
    {
    }for
    ]  %% fi de l'array d'imposició
   }
   {
    dup 0 lt
    {  %% hi haurà 1 sol llibret amb pàgines en blanc (null) que inicialment situarem a la cua
     abs /dNULLS exch def
     1 1 pPDF
     {
     }for
     dNULLS
     {
      null
     }repeat
     ]  %% fi de l'array d'imposició
    }
    {  %% hi hauran 2 o més llibrets encartats
     %% deduïm quants llibrets sortiran a part del llibret central
     dup Nup 2 mul div ceiling cvi dup
     /Nllibrets exch def  %% és el nombre de llibrets (arrays) que envolten al llibret central
     div Nup 2 mul exch sub dup 0 ne  %% hi hauran pàgines en blanc?
     {  %% SÍ, hi haurà pàgines en blanc
      Nllibrets mul round cvi
      /enBlanc exch def  %% nombre de pàgines en blanc
     }
     {  %% NO hi haurà pàgines en blanc
      pop
      /enBlanc 0 def
     }ifelse

     1 /PgEncartada exch def

     Nllibrets
     {  %% meitat dels llibrets encartats a l'esquerra
      1 1 Nup
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      [
     }repeat
     enBlanc 0 ne  %% hi ha pàgines en blanc?
     {  %% sí
      Nup enBlanc sub dup 0 lt
      {  %% si és més petit de zero és que també hi haurà pàgines en blanc al llibret central o a la penúltima array
       abs cvi /dNULLSc exch def  %% nombre de null que indiquen pàgines en blanc al llibret central o a la penúltima array
       /dNULLS Nup def  %% nombre de null que indiquen pàgines en blanc al llibret més extern
       %% ara aquí cal esbrinar si /dNULLSc va al llibret central o a la penúltima array
       Nllibrets 1 eq     %% només si és 1 durà null al llibret central
       {
        /blanquesALmig true def
        /blanquesALpenultim false def
       }
       {
        /blanquesALpenultim true def
        /blanquesALmig false def
       }ifelse
      }
      {
       pop enBlanc cvi /dNULLS exch def  %% nombre de null que indiquen pàgines en blanc al llibret més extern
       /blanquesALmig false def
       /blanquesALpenultim false def
      }ifelse
      /blanquesAcua true def
     }
     {  %% no
      /blanquesALmig false def
      /blanquesAcua false def
      /blanquesALpenultim false def
     }ifelse

     %% llibret central
     blanquesALmig  %% n'hi ha?
     {  %% fins on arriben les pàgines del PDF?
      1 1 Nup 2 mul dNULLSc sub
     }
     {  %% comportament normal
      1 1 Nup 2 mul
     }ifelse
     {
      pop PgEncartada dup 1 add /PgEncartada exch def
     }for
     blanquesALmig  %% n'hi ha?
     {
      dNULLSc
      {  %% acabem de farcir amb null el llibret central on no arriben les pàgines del PDF
       null
      }repeat
     }if
     ]

     %% meitat dels llibrets encartats a la dreta
     enBlanc 0 ne
     {  %% hi ha pàgines blanques
      blanquesALpenultim blanquesAcua and
      {  %% a la cua i al penúltim array
       Nllibrets 2 sub  %% fem tots els llibrets menys els 2 darrers
      }
      {  %% només a la cua
       Nllibrets 1 sub  %% fem tots els llibrets menys el darrer
      }ifelse
     }
     {  %% comportament normal
      Nllibrets
     }ifelse
     {  %% repeat
      1 1 Nup
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      ]
     }repeat

     %% aquí el penúltim llibret/array per ficar null com a pàgines en blanc en cas que n'hi hagi
     blanquesALpenultim  %% hi ha pàgines en blanc a la penúltima array?
     {
      1 1 Nup dNULLSc sub  %% escrivim la cua de pàgines finals del PDF
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      %% la cua de pàgines en blac
      dNULLSc
      {
       null
      }repeat
      ]
     }if

     %% aquí el darrer llibret/array per ficar null com a pàgines en blanc en cas que n'hi hagi
     blanquesAcua  %% hi ha pàgines en blanc?
     {
      1 1 Nup dNULLS sub  %% escrivim la cua de pàgines finals del PDF
      {
       pop PgEncartada dup 1 add /PgEncartada exch def
      }for
      %% la cua de pàgines en blac
      dNULLS
      {
       null
      }repeat
      ]
     }if
     %% la fi de l'array d'imposició ja va implícita
    }ifelse
   }ifelse

   /mapaDimposicio exch def
%== (matrius aniuades) ==  %pstack quit
  }
  {  %% apilem els pliegOS
   %% fem tants llibrets (nUps) de pàgines seguides fins que s'esgotin les pàgines de PDF a imposar (si falten pàgines s'omplen amb buides)
   %% calculem quants pliegOS ens surten i si hi ha pàgines en blanc (que ara deixarem a la cua)
   pPDF Nup mod 0 eq
   {  %% si la divisió és exacte voldrà dir que NO hi ha pàgines en blanc
    pPDF Nup 2 mul div /nPliegOS exch def  %% nombre de pliegOS
    /enBlanc 0 def
   }
   {  %% hi haurà pàgines en blanc
    pPDF Nup 2 mul div ceiling /nPliegOS exch def  %% nombre de pliegOS que generem
    %% pels pliegOS que generem comptem quantes pàgines en blanc necessitarem fins a completar el darrer nUp
    Nup 2 mul nPliegOS mul pPDF sub  %% restem les pàgines del PDF del nombre total de pàgines de l'nUp triat
    cvi /enBlanc exch def
   }ifelse

   [  %% com que els pliegOS van seguits ara posem totes les pàgines en 1 sol array
    1 1 pPDF  %%
    {
    }for
 
    enBlanc  %% si n'hi han, farcim la cua de pàgines en blanc per quadrar l'nUp
    {
     null
    }repeat
   ]
   /mapaDimposicio exch def
   %(APILEM)pstack quit
  }ifelse
 }ifelse

(        ) dup 2 pPDF 4 string cvs putinterval print flush ( ......... pagines del PDF d'entrada\n)print flush  %% nombre absolut de pàgines del PDF a imposar
(        ) dup 2 Nup 2 mul 4 string cvs putinterval print flush ( ......... pagines de l'nUp\n)print flush  %% pàgines d'1 sol llibre per l'nUp triat
(        ) dup 2 enBlanc 4 string cvs putinterval print flush ( ......... pagines en blanc\n)print flush  %% nobre de NULLs al mapa d'imposició

mapaDimposicio /ARArray exch def
/ignorades pPDF 1 add array def  %% el total de NULLs -1 que hi hagin en aquesta array serà el nombre de pàgines ignorades
{
 /sorTim true def
 ARArray
 {  %% forall
  dup type /nulltype eq
  {
   pop
  }
  {
   dup type /arraytype eq
   {
    /ARArray exch def
    /sorTim false def
   }
   {
    dup ignorades 3 1 roll put
   }ifelse
  }ifelse
 }forall
 sorTim
 {
  exit
 }if
}loop
/Pignorades -1 def
ignorades
{
 null eq
 {
  Pignorades 1 add /Pignorades exch def
 }if
}forall

(        ) dup 2 Pignorades 4 string cvs putinterval print flush ( ......... pagines ignorades\n)print flush  %% nombre de pàgines del PDF a imposar que no figuren al mapa d'imposició, llavors les repeticiions no compten

nqdrnt null eq
{
 1
}
{
 nqdrnt
 {
  Nllibrets 1 add
 }
 {
  nPliegOS
 }ifelse
}ifelse
(        ) dup 2 4 -1 roll 4 string cvs putinterval print flush
( ......... nombre de llibrets\n)print flush  %% nombre de pliegOS (nUps) encartats o apilats

nqdrnt null eq
{
 (  1 de sol    ) print flush
}
{
 nqdrnt
 {
  Nllibrets 1 add
  dup 1 eq
  {
   pop (  1 de sol    ) print flush
  }
  {
   2 string cvs
   (     encartats) dup 3 -1 roll 2 exch putinterval print flush
  }ifelse
 }
 {
  nPliegOS
  dup 1 eq
  {
   pop (  1 de sol    ) print flush
  }
  {
   2 string cvs
   (   apilats    ) dup 3 -1 roll 2 exch putinterval print flush
  }ifelse
 }ifelse
}ifelse

( ......... tipus d'enquadernat final\n)print flush %% 1 sol pliegOS o més d'1, encartat o apilat
 ( ......... pagines totals de la tripa\n\n)print flush  %% pàgines sumades de tots els nUps
 ( ......... mapa d'imposicio\n\n)print flush  %% potencial array per posar al menú
 (STOP)pstack stop
}
{  %% FEM el llançat servint-nos del mapa d'imposició del menú
