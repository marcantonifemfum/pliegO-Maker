 }if

 M8
 /p+xica 10000 def
 /p+gran 0 def
 {  %% forall on deduïm quina és la pàgina més petita i quina la més gran
  {  %% forall
   dup type /integertype eq
   {
    dup p+xica lt
    {
     dup /p+xica exch def
     dup p+gran gt
     {
      /p+gran exch def
     }
     {
      pop
     }ifelse
    }
    {
     dup p+gran gt
     {
      /p+gran exch def
     }
     {
      pop
     }ifelse
    }ifelse
   }
   {
    pop
   }ifelse
  }forall
 }forall

 %% filtrem el cas que es dóna de tenir tot nulls al mapa d'imposició
 p+xica 10000 eq  %% i que fa que p+xica encara valgui 10000
 {
  /p+xica 0 def  %% la deixem a zero
 }if

 %% filtrem possibles desviacions dels límits
 p+xica dup 0 lt
 {
  pop /iLlançat 1 def
 }
 {
  /iLlançat exch def
 }ifelse
 p+gran dup poPDF gt
 {
  pop /fLlançat poPDF def
 }
 {
  /fLlançat exch def
 }ifelse


%% aquí pPDF ja no beu de M12 (les pàgines poden no ser correlatives) i llavors cal descomptar les repeticions i els null de pàgines en blanc que hi pugui haver entremig
 /d_pPDF
 <<  %% en aquest diccionari hi desarem com a claus (amb valor zero) els enters dels números de pàgina i quan hi hagi repeticions hi anirem sumant 1 al seu valor
   /NULL 0  %% comptador de les pàgines en blanc
 >> def
 [
  M8
  {  %% forall
   [ exch
    {  %% forall
     dup type /integertype eq
     {
      %% corregim i avisem de les correccions
      dup 0 lt
      {%% filtrem els números de pàgina negatius
       pop 1  %% hi posem la pàgina 1
       (\n\n >>>> rectifiquem el valor negatiu d'inici de la primera pagina\n\n)print flush
      }if
      %% filtrem els números de pàgina més enllà de poPDF
      dup poPDF gt
      {
       pop poPDF  %% hi posem el valor de la darrera pàgina del PDF
       (\n\n >>>> rectifiquem el valor de final de pagina per superar el maxim permes\n\n)print flush
      }if
      dup  %% i en deixem una còpia a l'stack
      6 string cvs dup d_pPDF exch known
      {  %% si el núm. de pàgina ja existeix és que és una repetició
       dup d_pPDF exch get 1 add d_pPDF 3 1 roll put  %% el desem de nou augmentant el comptador
       (\n\n >>>> teniu una pagina repetida\n\n)print flush
      }
      {  %% el núm. de pàgina NO existeix
       d_pPDF exch 0 put
      }ifelse
     }
     {  %% aquí no filtrem errors encara i donem per fet que és un null
      d_pPDF dup /NULL get 1 add /NULL exch put
     }ifelse
    }forall
   ]
  }forall
 ]

 d_pPDF length 1 sub /pPDF exch def  %% total de pàgines a imposar del PDF d'origen
 d_pPDF /NULL get /enBlanc exch def
 /rEpEtIcIons 0 def
 d_pPDF
 {
  exch /NULL ne
  {  %% és un número de pàgina
   rEpEtIcIons add /rEpEtIcIons exch def
  }
  {  %% és el valor de NULL
   pop
  }ifelse
 }forall
 /M8 exch def
 /mapaDimposicio M8 def

}ifelse

