%!
%% fem un test critic pel retallador de pliegO'Maker

%%Pàg.1
<<
  /PageSize[ 3 3 ]
>>setpagedevice

%% cairó negre
1 1 1 1 setcmykcolor
0 0 2 2 rectfill

%% cairó groc
0 0 1 0 setcmykcolor
2 0 1 1 rectfill

%% cairó magenta
0 1 0 0 setcmykcolor
1 1 1 1 rectfill

%% cairó cyan
1 0 0 0 setcmykcolor
0 2 1 1 rectfill

mark /CropBox [0 0 1 1] /PAGE pdfmark
showpage

