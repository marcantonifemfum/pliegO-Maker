%%UBESH eixorbar: són els píxels d'ample i píxels d'alt de la iMosaic
/pntX piX def  %% meitat dels punts d'amplada de la imatge final
/pntY piY def  %% meitat dels punts de llargada "       "

rd
/rmvt exch def  %% ample del pixel (antic moviment relatiu entre caracters)

/255a100 100 255 div def  %% conversor de valors 0-255 a 0-100

/cX 0 def  %% posicions inicials dels caracters
/cY 0 def

/maXgraella 0 def  %% valor inicial de la variable de control per no excedir l'ample del pixel

%%UBESH eixorbar: apunta al RAW de la iMosaic
ElFitxer
(r) file
/digitAl exch def

/estT true def  %% pestell per executar el calcul de temps 1 cop

/HvY
{
 0  %% comptador inicial
 {  %% inici del loop

  %% algorisme d'estimacio de temps segons la primera imatge pintada
  estT
  {
   %usertime
   realtime /UNAi exch def /estT false def /estTfi true def
  }if

  cX cY  %% posicio de l'inici de caracter

  %% estrategia per fer treballar el text amb composicio natural

  cX maXgraella ge
  {

%%%%%%%%%%%%%%  nous afegits de color

   lleGeiX ECdex get  %% repeticions de lectura de pixel

   {  %% repeat
    digitAl read  %% llegeix el pixel

    {

%dup ==

     piNta ECdex get cvx exec  %% conversio a de color que toca
    } 
    {
     false
    }ifelse  %% si arriba al final del fitxer deixa un false per sortir del loop
   }repeat


   eSpai ECdex get cvx exec  %% activacio de l'espai, la conversio i pintat

%%%%%%%%%%%%%%

   maXgraella rd add /maXgraella exch def  %% actualitzem
   /smp true def  %% sumem el pixel al compador de columnes ?
  }
  {

%%%%%%%%%%%%%%  nous afegits de color

   eSpai ECdex get cvx exec  %% activacio de l'espai, la conversio i pintat

%%%%%%%%%%%%%%

   true  %% torna a posar el valor del pixel anterior
   /smp false def  %% sumem el pixel al comptador de columnes
  }ifelse

  {
   2 -1 roll 2 -1 roll

   %false setpacking

   %currentpacking pstack quit

   %% desem les transfers en un fitxer
   true setglobal
   %macOS
   %{(:tmp:ctransfer)}
   %{(./tmp/ctransfer)}ifelse

   aFeGeiX (w) file /Ctransfer exch def

   false setglobal

%%%%%%%%%%%%%%%%%%% calibració de color idem paparazzialea

   %% filtrem el valor de RaNG perque estigui entre + gran de zero i 1
   RaNG 0 le
   {

%%UBESH eixorbar: passem a mínims el valor més acostat a zero pel tal que la transfer dinàmica faci desaparèixer el color de les imatges constructores
    0.01 /RaNG exch def

   }if  %% si 0 o mes petit el deixem a .1
   
   RaNG 1 gt
   {
    1 /RaNG exch def
   }if  %% si es mes gran de 1 el deixem a 1

   %& escrivim els 3 array de transferencia

   %& Roig
   R RaNG sub 0 le
   {
    0 /MinR exch def
   }
   {
    R RaNG sub /MinR exch def
   }ifelse
   Ctransfer ( /TransferR [) writestring
   R 0 eq
   {
    256
    {
     Ctransfer 48 write Ctransfer 32 write
    }repeat
   }
   {
    R MinR sub 256 div MinR exch R
    {
     20 string cvs Ctransfer exch writestring Ctransfer 32 write
    }for
   }ifelse
   Ctransfer (] def ) writestring

   %&Verd
   G RaNG sub 0 le
   {
    0 /MinG exch def
   }
   {
    G RaNG sub /MinG exch def
   }ifelse
   Ctransfer ( /TransferG [) writestring
   G 0 eq
   {
    256
    {
     Ctransfer 48 write Ctransfer 32 write
    }repeat
   }
   {
    G MinG sub 256 div MinG exch G
    {
     20 string cvs Ctransfer exch writestring Ctransfer 32 write
    }for
   }ifelse
   Ctransfer (] def ) writestring

   %&Blau
   B RaNG sub 0 le
   {
    0 /MinB exch def
   }
   {
    B RaNG sub /MinB exch def
   }ifelse
   Ctransfer ( /TransferB [) writestring
   B 0 eq
   {
    256
    {
     Ctransfer 48 write Ctransfer 32 write
    }repeat
   }
   {
    B MinB sub 256 div MinB exch B
    {
     20 string cvs Ctransfer exch writestring Ctransfer 32 write
    }for
   }ifelse
   Ctransfer (] def ) writestring

   %% escrivim la crida de la transfer
   Ctransfer ( {255 mul cvi TransferR exch get}{255 mul cvi TransferG exch get}{255 mul cvi TransferB exch get}{0 mul} setcolortransfer ) writestring

%%%%%%%%%%%%%%%%%%% fins aqui lo del paparazzialea

   Ctransfer closefile

   %% executem l'espai de color particular de cada imatge
   %AlbUm BOMBOi 5 string cvs get
%%UBESH eixorbar: és aquí on tenim ara els path a les iConstructores
   %iArray RODAi get
   %/iCanals get
   %/SCE get exec
   /DeviceRGB setcolorspace

   %macOS
   %{(:tmp:ctransfer)}
   %{(./tmp/ctransfer)} ifelse

   aFeGeiX
   (r) file cvx exec

   %true setpacking

   /alCel save def

   iMides  %% captura les x,y escalades de la imatge abans d'executar image

   capOpeus
   {
    pelCap sub
   }if  %% arrenglerem pel cap de la imatge ?

   translate GoMeT  %image

   %RODAdic RODAi 10 string cvs cvn get image

   alCel restore

   % dup type /dicttype eq {pop}if
   %grestore

%   ALEAi  %% fem l'aleatori ?
%   {
    %% comptador de l'aleatori
%    RODAi enTens eq
%    {
%     /RODAi -1 def
     %% definicions aleatories
%     usertime srand
     %% aixo ho necesita el GS xq realment sigui aleatori?
