%% captura de dades de capçalera de eixorbar_DaaaLi_00_UBESH.ps 

/FiConstructores exch def  %% 2 %% JPEG a deslligar, píxel a píxel, en imatges constructores

/FiMosaic exch def  %% 1 %% JPEG base del mural


%% llegim les dades del JPEG base del mural
mark  %% per netejar la brossa
FiMosaic
%% captura de dades del JPEG i comprovacio de si existeix...
dup status
{
 pop pop
 % el fitxer fa...
 /FiFtxr exch def pop
 dup /elD'ara exch def  % path+Nom del fitxer que processem
 (r) file /tesela exch def  % fitxer de lectura
}
{
 (el JPEG base del mural NO HI ES...) == tesela closefile quit
}ifelse

%% mirem el cap i els peus (marcadors d'inici i final) del fitxer aviam si son normatius...
tesela FiFtxr 2 sub setfileposition
tesela 2 string readstring pop <FFD9> eq
{

%%SNRD matem els missatges
%(PEUS OK) ==

 tesela dup 0 setfileposition
 2 string readstring pop <FFD8> eq
 {

  %%SNRD matem els missatges
  %(CAP OK) ==

  /SoRTiM false def  % pestell de sortida

  %% explorem el fitxer per localitzar els marcadors significatius que duen les dades d'imatge (qualsevol d'ells es valid)

  {  % loop
   tesela 2 string readstring  %% llegim el segment
   {
    /SeGMeNT exch def
    0 1 6
    {  %% for
     [<FFC0> <FFC1> <FFC2> <FFC3> <FFC5> <FFC6> <FFC7>]  %% marcadors significatius
     exch get SeGMeNT eq
     {
%%SNRD matem els missatges
% (JA EL TINC !!!) ==

      tesela 10 string readstring pop

      %% captura del valor de files (y)
      dup dup 3 get 256 mul exch 4 get add

%%SNRD matem els missatges
% (\n >>>> Files (Y) ... ) print flush dup ==

      /_Bib exch def  % (Y) FILES D'IMATGE

      %% captura del valor de columnes (x)
      dup dup 5 get 256 mul exch 6 get add

%%SNRD matem els missatges
% (\n >>>> Columnes (X) ... ) print flush dup ==

      /_Aib exch def  % (X) COLUMNES D'IMATGE

      %% captura dels components de color (1, 3 o 4 canals)
      dup dup 7 get

%%SNRD matem els missatges
% (\n >>>> Components de Color ... ) print flush dup ==

      /CNLib exch def

      %% bits per component de color (o per pixel)
      dup dup 2 get

%%SNRD matem els missatges
% (\n >>>> Bits x Comp ... ) print flush dup == (\n\n) print flush

      /bXpib exch def

      /SoRTiM true def
     }if
    }for
    SoRTiM not
    {
     tesela 2 string readstring
     {  %% llegim la llargada del segment per saltar al seguent...
      dup 0 get 256 mul exch 1 get add
      2 sub string tesela exch readstring
      {
       pop
      }
      {
       pop tesela closefile exit
      }ifelse
     }
     {
      pop tesela closefile exit
     }ifelse
    }if
   }
   {
    pop tesela closefile exit
   }ifelse
   SoRTiM
   {
    tesela closefile exit
   }if
  }loop

  SoRTiM not
  {
   (\n\n <<<< NO podem llegir correctament les dades d'aquest JPEG base del mural\n\n) print flush
  }if
 }
 {
  (AP KAPPUT del JPEG base del mural)==
 }ifelse
}
{
 (PEUS KAPPUT del JPEG base del mural)==
}ifelse

%% captura dels canals, espai de color i escala de treball per la imatge base del mural
{
 [
  0
  % 1 canal (ploma, escala de grisos)
  {/DCDib [0 1] def /SCEib {/DeviceGray setcolorspace} def}
  0
  % 3 canals (RGB, L*a*b*)
  {/DCDib [0 1 0 1 0 1] def /SCEib {/DeviceRGB setcolorspace} def}
  % 4 canals (CMYK)
  {/DCDib [1 0 1 0 1 0 1 0] def /SCEib {/DeviceCMYK setcolorspace} def}
]
CNLib get exec

} stopped
{ % canals incorrectes
 (\n\n <<<< Canals Incorrectes del JPEG base del mural...\n\n) print flush
}if

%%SNRD multiplicador que ens dóna el valor d'ample _A
%% escala  1 = 100% = 72 dpi
%XYlogo _A div
%/Scl exch def 

cleartomark  %% pot fer brossa

(\n\n\n)print flush
FiMosaic ==
( >>> el JPEG base del mural fa... )print flush _Aib 4 string cvs print flush ( x )print flush _Bib 4 string cvs print flush
( pixels | a... )print flush CNLib 1 string cvs print flush ( ...canals | a... )print flush bXpib 2 string cvs print flush ( ...bits\n\n)print flush


