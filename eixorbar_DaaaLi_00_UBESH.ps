%     }bind def
     %% nombre d'elements (fotos) a barallar
%     enTens 1 add /AfotoS exch def
%     AfotoS array /BoMBo exch def
%     0  %% index comptador per l'array
%     AfotoS 3 mul  %% tres cops el nombre d'elements
%     {
%      /HiEra false def
      %% sempre sortira un enter entre 0 i AfotoS-1
%      AfotoS number /HiEs exch def
%      BoMBo
%      {
%       HiEs eq
%       {
%        /HiEra true def exit
%       }if
%      }forall
%      HiEra not
%      {
%       dup BoMBo exch HiEs put 1 add
%      }if
%     }repeat
%     pop
%     %% fins aqui l'aleatori
%    }if
%    RODAi 1 add /RODAi exch def
    %% el treiem per ordre de l'aleatori actual i mirem si som al final per un null
%    BoMBo RODAi get dup null eq
%    {
%     pop enTens dup /RODAi exch def
%    }if
%    /BOMBOi exch def
%   }
%   {  %% NO
%%UBESH: exiorbar: en prescindim
%    RODAi enTens eq
%    {
%     /RODAi -1 def RODAi /BOMBOi exch def
%    }if

    RODAi 1 add /RODAi exch def
%    RODAi /BOMBOi exch def
%   }ifelse

   cX CoS add
   /cX exch def  %% actualitzem el valor de X per composicio natural
   smp
   {
    1 add
   }if  %% si hem repetit el pixel no el sumem
   dup  %% sumador del comptador
   piX
   eq
   {
    pop exit
   }if  %% has fet totes les columnes ?
  }if  %% s'executa mentre no arriba al final del fitxer

%%URGENT
RODAi 6615 eq{(SORTIMindexDURGENCIA!)== exit}if

 }loop
}bind def


/HvX
{

%%UBESH eixorbar | afegim un stopped per veure quin índex ens peta?
{  %% stopped

 0
 {  %% loop
  dup rmvt mul  %% multiplicant per l'index tenim la posicio d'inici de fila
  neg /cY exch def /cX 0 def  %% actualitzem els valors del centre per l'inici de cada fila
  /maXgraella 0 def
  HvY  %% fa totes les columnes de la fila corresponent

  %% algorisme d'estimació de temps segons la primera línia d'imatges pintades
  estTfi
  {
   /estTfi false def BaBeL 23 get print flush
   %usertime
   realtime UNAi sub 1000 div piY mul 60 div truncate cvi 5 string cvs print flush
   BaBeL 24 get print flush
%(COMCOMPTESARA?)pstack quit
  }if

  1 add dup  %% sumador del comptador

  %% comptador del % de la imatge construida
  dup piX mul 100 mul piX piY mul div round cvi 20 string cvs print flush (%\n . . . .  ) print flush

  piY
  eq
  {
   pop BaBeL 17 get print flush exit
  }if  %% has fet totes les files ?

 }loop

}stopped{(<<<<<ON PETES?)== quit}if

}bind def

