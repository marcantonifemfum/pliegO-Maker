%% aquesta utilitat genera imatges alternatives per impressió
%% incrustades en el mateix PDF a traves de codis pdfmark

%% amb la gran novetat d'utilitzar mascares sofisticades de PS tipus 4
%% que en codi PDFmark queden transformades a una imatge amb color indexat
%% que duu la clau /Mask amb l'array del color a emmascarar


<</PageSize[200 200]>>setpagedevice

%AlterEgo = 123
%AlterEgoStream = 456
%LaMascaraXdemo = 789

%% li posem x sota x veure que va la mascara
gsave
0 1 0 setrgbcolor
0 0 200 200 rectfill
grestore

% anomenem la imatge x pantalla
[/_objdef {ImatgeXpantalla} /NI pdfmark

0 200 translate
200 200 scale

gsave

/DeviceRGB setcolorspace

% executem la imatge x pantalla
<<
	  /ImageType 4
	  /Width 8
	  /Height 8
	  /BitsPerComponent 8
	  /Decode [0 1 0 1 0 1]
	  /ImageMatrix [ 8 0 0 -8 0 0]
	  /DataSource () 0 () /SubFileDecode filter /ASCIIHexDecode filter
/MaskColor [255 255 255]  % nova clau per la mascara de color precis o amb rang
	  >> image

grestore


% creem l'stream de dades indexades per la imatge alternativa
[/_objdef {PixelsIndexats} /type /stream /OBJ pdfmark


% llegim el fitxer a incrustar a AlterEgo
% les dades d'imatge han de ser binaries (cal provar amb hexa) doncs ell sempre
% les acaba comprimint amb Flate o LZW. En el cas que llegim dades DCT (jpg) cal decodificar-les
% abans d'entar-les a l'stream de dades

%%%% en raw directe
%(C:/MaRCanToni/FemFum/projectes/LlumiColor/_Atles_/7______________0.raw) (r) file

