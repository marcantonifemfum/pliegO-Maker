% incrustem el fitxer de lectura dins l'stream
[{PixelsIndexats} 2 index /PUT pdfmark

closefile  % tanquem el fitxer que queda a la pila


% creem l'stream de dades dels index de la imatge alternativa
[/_objdef {TaulaDeColors} /type /stream /OBJ pdfmark


% llegim el fitxer a incrustar a AlterEgo
% les dades d'imatge han de ser binaries (cal provar amb hexa) doncs ell sempre
% les acaba comprimint amb Flate o LZW. En el cas que llegim dades DCT (jpg) cal decodificar-les
% abans d'entar-les a l'stream de dades
(ÿÿÿÿ     
) 0 () /SubFileDecode filter

% incrustem el fitxer de lectura dins l'stream
[{TaulaDeColors} 2 index /PUT pdfmark

closefile  % tanquem el fitxer que queda a la pila

%%%%%%%%%% desactivat aqui
false {
%%%%%% creacio de l'objecte de la imatge de mascara per demo
% creem l'stream de dades per l'objecte d'imatge de mascara per Demo (logo FemFum)
[/_objdef {LaMascaraXdemo_789} /type /array /OBJ pdfmark
% entrem les dades del dict d'imatge de mascara
[{LaMascaraXdemo_789}
0 [0 0] /PUTINTERVAL pdfmark
%%%%%%% fi de dades de mascara
} if
%%%%%%%%%% fi de desactivat

% entrem les dades d'imatge a l'stream alternatiu
[{PixelsIndexats}
<<
   /Type /XObject /Subtype /Image
   /Width 32 /Height 32
   /ColorSpace [/Indexed /DeviceRGB 2 {TaulaDeColors}]
   /BitsPerComponent 8
   /Name /FemFum_AlterEgo
   % clau amb el rang de l'index del color (blanc) per emascarar les impressions per Demo amb el blanc del logo de FemFum
   /Mask [0 0]
>> /PUT pdfmark

% tanquem l'stream
[{PixelsIndexats} /CLOSE pdfmark


% creem les entrades de la imatge alternativa
[{ImatgeXpantalla} << /Alternates [ <</Image {PixelsIndexats}
/DefaultForPrinting true >> ] >> /PUT pdfmark

% CATALOG INFO
 [
	/Title (AlterEgo.PDF)
	/Subject (Embedded Alternate Image For Printing)
	/Author (<marcantoni@femfum.com>)
	/Creator (\251 FemFum PostScript Applet)
	/DOCINFO
pdfmark

showpage

