/perPoc true def  % pestell per si hem de fer el darrer proces

%% captura del valor de files (y)
%% files (y)
tesela dup laVeta 3 add setfileposition read pop 256 mul
tesela dup laVeta 4 add setfileposition read pop add  %(\n\n >>>> Files (Y) ... ) print flush ==
/_B exch def  % (Y) FILES D'IMATGE

%% captura del valor de columnes (x)
%% columnes (x)
tesela dup laVeta 5 add setfileposition read pop 256 mul
tesela dup laVeta 6 add setfileposition read pop add  %(\n\n >>>> Columnes (X) ... ) print flush ==
/_A exch def  % (X) COLUMNES D'IMATGE

%% captura dels components de color (1, 3 o 4 canals)
%% components de color
tesela dup laVeta 7 add setfileposition read pop  %(\n\n >>>> Components de Color ... ) print flush ==

/CNL exch def

%% bits per component de color (o per pixel)
tesela dup laVeta 2 add setfileposition read pop  %(\n\n >>>> Bits x Comp ... ) print flush ==
/bXp exch def

{
[
0
 % 1 canal (ploma, escala de grisos)
{(/DeviceGray)}
0
 % 3 canals (RGB)
{(/DeviceRGB)}
 % 4 canals (CMYK)
{(/DeviceCMYK)}
]
CNL get exec
/ElsCanals exch def
