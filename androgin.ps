pErmEsOs
/maxEPS exch def
0 /EPSfets exch def  % comptador d'EPS processats a filenameforall

true setglobal
pErmEsOs 2 mul array  % maxim nombre de fitxers 
/EsbOrrEm exch def  % llistat de fitxers a esborrar fora del filefor (a dins no es deixa!)
0 /EsbOrrEm_i exch def  % index de fitxers a esborrar
false setglobal

/Donegal 256 string def


/salva'm save def


aDestilar

