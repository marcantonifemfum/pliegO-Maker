save
(NO HE TROBAT la Clau Anterior ... L'actual es ... ) /ClauVella exch def
% fitxer amb la clau digital LicenseID
currentsystemparams dup /LicenseID known
{/LicenseID get}{(Sense LicenseID)}ifelse
% personalitzem el nom del fitxer amb la clau digital per cada maquina (conte les darreres 8 xifres)
%%dup length 8 sub 8 getinterval
dup length 0 exch getinterval  %% GS
(________.fum) dup 3 -1 roll 0 exch putinterval
 /res exch def
res length seP length add string /_oN exch def
_oN 0 seP putinterval
_oN seP length res putinterval

%% UTILITAT COMPRESSORA DE FITXERS POSTSCRIPT
%% CODIFICA UN FITXER (o currentfile) A LZW, ASCII85 O HEXA (TN#5115)

_oN (w) file  % fitxer final comprimit i codificat
/PreSsor exch def

% codi decodificador opcional al cap del fitxer
PreSsor dup

/bufaBuffer 65535 string def

/escup
PreSsor
/ASCII85Encode filter
/LZWEncode filter
def

/xucla  % AQUI EL NOM DEL FITXER A COMPRIMIR
currentsystemparams dup /LicenseID known
{
 /LicenseID get dup length ClauVella length dup /LiD exch def add string dup
 0 ClauVella putinterval dup 3 -1 roll LiD exch putinterval
}
{
 (Sense LicenseID) dup length ClauVella length dup /LiD exch def add string dup
 0 ClauVella putinterval dup 3 -1 roll LiD exch putinterval
}
ifelse  0 () /SubFileDecode filter  % procs i strings com a fitxers
def

/fot-li
{
 {
  xucla
  bufaBuffer readstring not
  {
   escup exch writestring
   exit
  } if
  escup exch writestring
 } loop
 escup closefile
 flush
} bind def

fot-li

pop pop  % ens carreguem 2 file de la pila

%%%% FI D'UTILITAT COMPRESSORA

restore
%%%%%%%%%%% FI DE CLAU DIGITAL COMERCIAL (/LicenseID)


%%% definim l'algorisme de trasllat de fitxers
%%% agafa un fitxer de lectura directament i cal definir 'trAsllAt' com a fitxer d'escriptura

/TRASLLAT {
{
 dup 65535 string readstring	{
				 trAsllAt exch writestring
				}
				{
				 trAsllAt exch writestring
				 closefile exit
				} ifelse
} loop 
} bind def


%%%%% empalmem l'extensio que busquem amb el path de la HotFolder
_IN  % path de la Hot Folder
/DIR exch def
/elPS (*.EPS) def  % l'extensio que busquem
% ensamblem fitxer+adreça del fitxer a modificar
% filtrant si porta el darrer caracter separador (bUsca / o :)
DIR dup length 1 sub get bUsca 0 get eq
{  % el path porta el caracter final separador
 elPS length DIR length dup /ffitx exch def
 add string dup 0 DIR putinterval dup ffitx elPS putinterval
}
{  % el path no porta el darrer caracter separador
 elPS length DIR length dup /ffitx exch def
 add 1 add string dup 0 DIR putinterval dup ffitx bUsca putinterval
 dup ffitx 1 add elPS putinterval
} ifelse
/aDestilar exch def

/noEPS true def  % pestell per si no hi ha fitxers EPS

5 /pErmEsOs exch def  % maxim nombre de fitxers permesos

%%%%%%%%%%%%%%%%%% va en conjunt al maxim de fitxers permesos alhora x Demo
