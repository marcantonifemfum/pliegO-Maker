false{

%%%%%% escrivim codificat i comprimit aquesta segona part de strEAm1 a l'EPS
strEAm1 (r) file /pelTurmix exch def

%% UTILITAT COMPRESSORA DE FITXERS POSTSCRIPT
%% CODIFICA UN FITXER (o currentfile) A LZW, ASCII85 O HEXA (TN#5115)

save

%% creem el fitxer aqui
trAsllAt /totEPSfile exch def

totEPSfile  % fitxer final comprimit i codificat
/PreSsor exch def

% codi decodificador opcional al cap del fitxer
PreSsor dup
(\015currentfile /ASCII85Decode filter /FlateDecode filter cvx exec) writestring 13 write

/bufaBuffer 65535 string def

/escup
PreSsor
/ASCII85Encode filter
/FlateEncode filter
def

/xucla  % AQUI EL NOM DEL FITXER A COMPRIMIR
pelTurmix 
def

/fot-li
{
 {
  xucla
  bufaBuffer readstring not
  {
   escup exch writestring
   exit
  } if
  escup exch writestring
 } loop
 escup closefile
 flush
} bind def

fot-li

totEPSfile flushfile

restore
%%%% FI D'UTILITAT COMPRESSORA

}if  %%GS no comprimim a Flate/ASCII85 ?


trAsllAt dup (\015%%EOF\015) writestring flushfile

