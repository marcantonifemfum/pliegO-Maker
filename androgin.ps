   tiBades 1 add /tiBades exch def

   closefile  % tanquem el fitxer

   exit  % sortim del loop 2

  } if  % si ha arribat al final del fitxer ho executa

  dup  % dupliquem la cadena
  length posFITX add /posFITX exch def  % n'avaluem la capacitat, ho sumem a l'avaluador de posicio de fitxer (posFITX) i redesem
  ESCRiURE exch writestring  % escrivim la cadena al fitxer d'escriptura

 } loop  % final loop 2

