 tesela
 <<
 /Filter /SubFileDecode
 /DecodeParms <</EODCount 0 /EODString (\377\300)>>
 %/Intent 3
 >> /ReusableStreamDecode filter pop

 tesela fileposition dup FiFtxr eq
 {pop exit}  % sortim tenint desada la darrera posicio (que es la bona!) de (\377\300)
 {/laVeta exch def}  % desem la posicio del doble byte clau on s'inicia la informacio d'imatge que necessitem
 ifelse
} loop

laVeta 0 ne  % fitxer erroni (no te el doble byte clau)

