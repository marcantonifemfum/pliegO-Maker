%%%% fi de lectura de dades del JPG

%%%% aqui l'if per no fer la resta del proces per si hi ha un error en la lectura del JPEG

perPoc {  % fem el darrer proces?

%%%% aqui hauriem de fer una comparativa en % de resolucio entre l'EPS/JPEG i proporcionalitat
%%%% per treure-ho pel prompt del Distiller

%%%% fem una regla de tres per saber si la imatge alternativa (JPG) es proporcional a l'EPS
%%%% amb un error de 5 punts considerem que ho es, si no
BaBeL 18 get print flush 
realAmple realAlt _A mul exch div cvi _B sub abs 5 gt
{BaBeL 21 get print flush}{BaBeL 20 get print flush }ifelse
BaBeL 19 get print flush 

%%%% cerquem el % de comparativa en la resolucio entre l'EPS/JPEG
BaBeL 22 get print flush 
_A realAmple div 100 mul  % el percentatge de resolucio d'ample de l'alternativa
50 string cvs print flush ( %) print flush
BaBeL 23 get print flush 
_B realAlt div 100 mul  % el percentatge de resolucio d'alt de l'alternativa
50 string cvs print flush ( %) print flush
BaBeL 24 get print flush 


% entrem les dades d'imatge a l'stream alternatiu
strEAm1_pla ([{) writestring
strEAm1_pla AlterEgoStream 100 string cvs writestring
strEAm1_pla (} << /Type /XObject /Subtype /Image /Width ) writestring
% l'ample de la imatge JPG
strEAm1_pla _A 100 string cvs writestring
strEAm1_pla (/Height ) writestring
% l'alt de la imatge JPG
strEAm1_pla _B 100 string cvs writestring
strEAm1_pla (/ColorSpace ) writestring
% l'espai de color del JPG
strEAm1_pla ElsCanals writestring
					 %% no utilitzem bXp doncs segur que sempre treballarem a 8
strEAm1_pla ( /BitsPerComponent 8 /Name ) writestring
% muntem el nom unic (/FemFum_AlterEgo_) + (numeric aleatori unic AlterEgo)
(/FemFum_AlterEgo_) dup length dup /MiG exch def AlterEgo 100 string cvs  dup length 3 -1 roll
add string /tOtA exch def exch tOtA exch 0 exch putinterval tOtA exch MiG exch putinterval
strEAm1_pla tOtA writestring
% entrem la clau per emascarar les impressions per Demo amb el logo de FemFum a 1 bitXpixel
strEAm1_pla ( /Mask {) writestring
strEAm1_pla LaMascaraXdemo 100 string cvs writestring
strEAm1_pla (} >> /PUT pdfmark [{) writestring
% tanquem l'stream + creem les entrades de la imatge alternativa
strEAm1_pla AlterEgoStream 100 string cvs writestring
strEAm1_pla (} /CLOSE pdfmark [{) writestring
strEAm1_pla AlterEgo 100 string cvs writestring
strEAm1_pla (} << /Alternates [ <</Image {) writestring
strEAm1_pla AlterEgoStream 100 string cvs writestring
strEAm1_pla (} /DefaultForPrinting true >> ] >> /PUT pdfmark) writestring

strEAm1_pla closefile


