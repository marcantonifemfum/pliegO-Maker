 } if

_ERRORS _OUT eq _IN _OUT eq _ERRORS _IN eq or or  % hi han 2 o mes path iguals ?
{BaBeL 7 get print flush quit} if


%%%% UTILITAT PER COMPROVAR EL S.O.

mark  % tanca de recollida d'escombraries

% comprova si es Mac o Win

/MoW 0 def
% comprova si trova fitxers o directoris amb l'identificador del Mac
(:*) {MoW 1 add /MoW exch def} 100 string filenameforall
MoW 0 eq{
	  /seP (./) def			% utilitzat per fademo
	  /bUsca (/) def		% utilitzat a l'applet per extraure el nom del fitxer
	  /strEAm1 (tmp/stream_1) def	% primer paquet de dades per comprimir
	  /strEAm2 (tmp/stream_2) def	% segon paquet de dades per comprimir
	  /tEmp (tmp/) def		% utilitzat a l'applet per desar tots els streams
	  /capEPS (tmp/cap_eps) def	% nomes capcalera
	  /NOMfitx (tmp/eps_net) def	% eps temporal net de capcaleres
	  /JPGpla (tmp/jpg_pla) def	% jpg decodificat
	 }  % Win/Linux  %% GS
	 {  % Mac
	  /seP (:) def
	  /bUsca (:) def		% utilitzat a l'applet per extraure el nom del fitxer
	  /strEAm1 (:tmp:stream_1) def	% primer paquet de dades per comprimir
	  /strEAm2 (:tmp:stream_2) def	% segon paquet de dades per comprimir
	  /tEmp (:tmp:) def		% utilitzat a l'applet per desar tots els streams
	  /capEPS (:tmp:cap_eps) def	% nomes capcalera
	  /NOMfitx (:tmp:eps_net) def	% eps temporal net de capcaleres
	  /JPGpla (:tmp:jpg_pla) def	% jpg decodificat
	 }ifelse  % sintaxi segons S.O.


cleartomark  % recull les possibles escombraries (p.e. a Mac OS)


